{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": ["app/**/*.{ts,tsx}", "components/**/*.{ts,tsx}", "app.json"],
  "project": ["**/*.{ts,tsx,js,jsx}"],
  "ignoreDependencies": ["react-dom", "expo-updates"],
  "ignoreBinaries": ["expo-doctor"],
  "ignoreExportsUsedInFile": true,
  "ignore": [
    "node_modules/**",
    ".expo/**",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "**/*.test.{ts,tsx,js,jsx}",
    "**/*.spec.{ts,tsx,js,jsx}",
    "**/__tests__/**",
    "types/database.types.ts",
    "constants/layout.ts",
    "constants/Colors.ts",
    "app/_layout.tsx",
    "app/review.tsx",
    "components/ActionButton.tsx",
    "components/ArticleHeader.tsx",
    "components/ArticleSentence.tsx",
    "components/Avatar.tsx"
  ]
}

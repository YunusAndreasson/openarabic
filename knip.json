{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "*.config.{js,ts,mjs}",
    "plugins/**/*.js",
    "scripts/**/*.{ts,mjs}"
  ],
  "project": [
    "**/*.{js,jsx,ts,tsx}",
    "!**/node_modules/**",
    "!**/patches/**",
    "!**/docs/**",
    "!**/translate/**",
    "!**/supabase/migrations/**",
    "!**/admin-dashboard/**",
    "!**/__tests__/**",
    "!**/__mocks__/**"
  ],
  "jest": false,
  "ignore": ["admin-dashboard/**", "types/database.types.ts", "jest.setup.js", "jest.polyfills.js"],
  "ignoreDependencies": [
    "babel-preset-expo",
    "babel-jest",
    "@babel/plugin-transform-react-jsx",
    "@eslint/js",
    "@swmansion/argent",
    "eslint-plugin-react",
    "@jest/globals",
    "fast-check"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "includeEntryExports": false,
  "ignoreBinaries": ["supabase", "eas"],
  "exclude": ["duplicates"],
  "tags": ["-internal"]
}

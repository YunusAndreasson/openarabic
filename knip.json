{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{android,ios,native}.{ts,tsx}",
    "*.config.{js,ts,mjs}",
    "plugins/**/*.js",
    "scripts/**/*.{ts,mjs}"
  ],
  "project": [
    "**/*.{js,jsx,ts,tsx}",
    "!**/node_modules/**",
    "!**/patches/**",
    "!**/docs/**",
    "!**/translate/**",
    "!**/supabase/migrations/**",
    "!**/admin-dashboard/**"
  ],
  "ignore": ["admin-dashboard/**", "types/database.types.ts"],
  "ignoreDependencies": [
    "@expo/agent-cli",
    "@expo-google-fonts/material-symbols",
    "@eslint/js",
    "@swmansion/argent",
    "eslint-plugin-react"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "includeEntryExports": false,
  "ignoreBinaries": ["supabase", "eas"],
  "exclude": ["duplicates"],
  "tags": ["-internal"]
}

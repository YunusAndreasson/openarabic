{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "services/**/*.{ts,tsx}",
    "store/**/*.{ts,tsx}",
    "utils/**/*.{ts,tsx}",
    "constants/**/*.{ts,tsx}",
    "types/**/*.{ts,tsx}"
  ],
  "project": [
    "**/*.{js,jsx,ts,tsx}",
    "!**/*.test.{js,jsx,ts,tsx}",
    "!**/*.spec.{js,jsx,ts,tsx}",
    "!**/__tests__/**",
    "!**/node_modules/**",
    "!**/patches/**",
    "!**/docs/**",
    "!**/translate/**",
    "!**/supabase/migrations/**",
    "!**/admin-dashboard/**"
  ],
  "ignore": ["plugins/**", "scripts/**", "metro.config.js"],
  "ignoreDependencies": ["expo-constants", "babel-preset-expo", "babel-jest"],
  "ignoreExportsUsedInFile": false,
  "includeEntryExports": false,
  "ignoreBinaries": ["supabase", "gh", "list"],
  "exclude": ["duplicates"]
}

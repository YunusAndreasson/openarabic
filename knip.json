{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "components/**/*.{ts,tsx}",
    "hooks/**/*.{ts,tsx}",
    "services/**/*.{ts,tsx}",
    "store/**/*.{ts,tsx}",
    "utils/**/*.{ts,tsx}",
    "constants/**/*.{ts,tsx}",
    "types/**/*.{ts,tsx}"
  ],
  "project": [
    "**/*.{js,jsx,ts,tsx}",
    "!**/*.test.{js,jsx,ts,tsx}",
    "!**/*.spec.{js,jsx,ts,tsx}",
    "!**/__tests__/**",
    "!**/node_modules/**",
    "!**/patches/**",
    "!**/docs/**",
    "!**/translate/**",
    "!**/supabase/migrations/**"
  ],
  "ignore": [
    "patches/**",
    "docs/**",
    "translate/**",
    "supabase/migrations/**",
    "assets/**",
    "**/*.d.ts",
    "types/database.types.ts",
    "__mocks__/**",
    "__perf__/**",
    "babel.config.js",
    "metro.config.js",
    "metro.config.cjs",
    "jest.config.js",
    "jest.setup.js",
    "expo-router/entry",
    "expo/**",
    ".github/workflows/**",
    "@expo/metro-config",
    "metro-minify-terser"
  ],
  "ignoreExportsUsedInFile": false,
  "includeEntryExports": false,
  "ignoreBinaries": ["supabase", "gh", "eas"],
  "exclude": ["duplicates"]
}

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "*.config.{js,ts,mjs}",
    "plugins/**/*.js",
    "scripts/**/*.{ts,mjs}",
    "__tests__/**/*.{ts,tsx}"
  ],
  "project": [
    "**/*.{js,jsx,ts,tsx}",
    "!**/node_modules/**",
    "!**/patches/**",
    "!**/docs/**",
    "!**/translate/**",
    "!**/supabase/migrations/**",
    "!**/admin-dashboard/**"
  ],
  "ignore": ["admin-dashboard/**", "types/database.types.ts"],
  "ignoreDependencies": [
    "babel-preset-expo",
    "babel-jest",
    "@babel/plugin-transform-react-jsx",
    "@eslint/js",
    "@swmansion/argent",
    "eslint-plugin-react",
    "eslint-plugin-react-hooks"
  ],
  "ignoreExportsUsedInFile": { "interface": true, "type": true },
  "includeEntryExports": false,
  "ignoreBinaries": ["supabase", "eas", "list"],
  "exclude": ["duplicates"]
}

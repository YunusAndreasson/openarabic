{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"]
    },
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedSideEffectImports": true,
    "erasableSyntaxOnly": true,
    "lib": ["ESNext"],
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  // `.expo/types` holds the typed-routes declarations (`app.json` typedRoutes),
  // generated by the dev server or `npx expo customize tsconfig.json`. Keep
  // `.expo` out of `exclude`: an exclude beats this include, which silently
  // reduced `Href` to a plain string. `**` never descends into dot-directories,
  // so nothing else under `.expo` is picked up.
  "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "node_modules",
    "metro.config.js",
    "jest.config.js",
    "eslint.config.mjs",
    "build",
    "dist",
    "coverage",
    "translate",
    "assets",
    ".venv",
    "admin-dashboard",
    "__tests__"
  ]
}

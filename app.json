{
  "expo": {
    "name": "Open Arabic",
    "slug": "open-arabic",
    "version": "1447.12.11",
    "description": "Learn Arabic through immersive reading, listening, and spaced repetition practice. Master vocabulary with authentic articles and audio content.",
    "orientation": "portrait",
    "icon": "./assets/images/oaIcon.png",
    "scheme": "open-arabic",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#111614",
    "primaryColor": "#568066",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "openarabic",
      "buildNumber": "236",
      "appStoreUrl": "https://apps.apple.com/app/openarabic/id1594031029",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "processing",
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "BGTaskSchedulerPermittedIdentifiers": [
          "openarabic.backgroundtask",
          "openarabic.backgroundfetch"
        ],
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select screenshots for issue reports or profile photos.",
        "NSCameraUsageDescription": "This app needs access to your camera to let you take a profile photo for your account.",
        "NSMicrophoneUsageDescription": "Open Arabic uses the microphone to grade your spoken English answer. Audio is transcribed on your device and never leaves it.",
        "NSUserNotificationsUsageDescription": "This app sends study reminders to help you practice Arabic vocabulary at your scheduled times."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111614",
        "foregroundImage": "./assets/images/oaIcon.png"
      },
      "package": "com.edenmind.OpenArabic",
      "versionCode": 236,
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.WAKE_LOCK",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111614",
          "resizeMode": "contain",
          "image": "./assets/images/oaIcon.png"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/NotoSans.ttf",
            "./assets/fonts/Amiri.ttf",
            "./assets/fonts/Madina.otf",
            "./assets/fonts/Scheherazade.ttf",
            "./assets/fonts/Nastaliq.ttf",
            "./assets/fonts/Inter-Regular.ttf",
            "./assets/fonts/Inter-SemiBold.ttf",
            "./assets/fonts/Inter-Bold.ttf"
          ]
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "openarabic"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/oaIcon.png",
          "color": "#568066",
          "defaultChannel": "reminders",
          "sounds": [],
          "_comment": "Background remote notifications disabled - app uses local notifications only (no backend push notifications)",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true,
          "_comment": "Audio recording disabled - app only uses playback. Background playback enabled for lock screen controls."
        }
      ],
      "./plugins/withRemoveExpoAudioBootReceiver.js",
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "Open Arabic uses the microphone to grade your spoken English answer. Audio is transcribed on your device and never leaves it.",
          "iosBackgroundMode": false,
          "androidForegroundService": false,
          "androidPermissions": []
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "This app needs access to your photo library to let you select a profile photo for your account.",
          "cameraPermission": "This app needs access to your camera to let you take a profile photo for your account.",
          "microphonePermission": "This app needs access to your microphone for audio recording features."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.989500653316-f244cgfpisfpmhpgedcs3sdof3sirgdv"
        }
      ],
      "@react-native-community/datetimepicker",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "644480e0-3ac0-4ce6-b6ca-b950f62ca438"
      }
    },
    "owner": "edenmind",
    "runtimeVersion": "1447.9.12",
    "updates": {
      "url": "https://u.expo.dev/644480e0-3ac0-4ce6-b6ca-b950f62ca438",
      "enableBsdiffPatchSupport": true
    }
  }
}
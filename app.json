{
  "expo": {
    "name": "Open Arabic",
    "slug": "open-arabic",
    "version": "1446.10.36",
    "orientation": "portrait",
    "icon": "./assets/images/oa-logo.png",
    "scheme": "open-arabic",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "openarabic",
      "infoPlist": {
        "UIBackgroundModes": ["audio", "processing"],
        "ITSAppUsesNonExemptEncryption": false,
        "BGTaskSchedulerPermittedIdentifiers": [
          "openarabic.backgroundtask",
          "openarabic.backgroundfetch"
        ]
      },
      "buildNumber": "36"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212"
      },
      "package": "com.edenmind.OpenArabic",
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.WAKE_LOCK",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "imageResizeMode": "contain",
          "image": "./assets/images/oa-logo.png"
        }
      ],
      "expo-font",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "openarabic"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false,
          "androidScreenCapture": false,
          "foregroundService": {
            "name": "Audio Playback",
            "notificationTitle": "Open Arabic Audio",
            "notificationColor": "#1E1E1E",
            "notificationIcon": "./assets/images/oa-logo.png"
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/images/oa-logo.png",
      "backgroundColor": "#121212",
      "imageResizeMode": "contain",
      "resizeMode": "contain"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "644480e0-3ac0-4ce6-b6ca-b950f62ca438"
      }
    },
    "owner": "edenmind",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/644480e0-3ac0-4ce6-b6ca-b950f62ca438"
    }
  }
}

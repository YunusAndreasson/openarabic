      "expo-status-bar",
      [
        "react-native-fbsdk-next",
        {
          "_comment": "Meta app events for ad attribution. AEM-only: no ATT prompt is ever shown, so on iOS the IDFA stays zeroed and Meta attributes via Aggregated Event Measurement + SKAdNetwork. advertiserIDCollectionEnabled is a no-op on iOS without ATT, but IS what lets Android report the Google Advertising ID — that is where user-level attribution actually comes from.",
          "appID": "1579869453486353",
          "clientToken": "c39b97bf7d2917ab6725e95be8506aab",
          "displayName": "Open Arabic",
          "scheme": "fb1579869453486353",
          "isAutoInitEnabled": true,
          "autoLogAppEventsEnabled": true,
          "advertiserIDCollectionEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "_comment": "MMKV/MMKVCore arrive transitively via @kesha-antonov/react-native-background-downloader, whose podspec floats 'MMKV >= 1.2.0'. With no Podfile.lock in the repo (CNG), every EAS build re-resolves pods, so on 2026-08-02 it picked up MMKVCore 2.4.1 (published 2026-07-30), which calls memset_s — C11 Annex K, which Apple's libc does not implement — and the iOS build failed to compile AESCrypt.cpp. Pinning BOTH is required: MMKV 2.4.0 declares 'MMKVCore ~> 2.4.0', which would still admit 2.4.1. Drop this once upstream ships a fix.",
          "ios": {
            "extraPods": [
              {
                "name": "MMKVCore",
                "version": "2.4.0"
              },
              {
                "name": "MMKV",
                "version": "2.4.0"
              }
            ]
          }
        }
      ]
    ],

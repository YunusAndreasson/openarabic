  "Error Boundary Component": {
    "prefix": "error-boundary",
    "body": [
      "import React from 'react';",
      "import { View, Text } from 'react-native';",
      "",
      "import { handleError } from '@/utils/errorHandling';",
      "import { STRINGS } from '@/constants/strings';",
      "import { LAYOUT } from '@/constants/layout';",
      "",
      "interface ${1:ErrorBoundary}Props {",
      "  children: React.ReactNode;",
      "  fallback?: React.ComponentType<{ error: Error }>;",
      "}",
      "",
      "interface ${1:ErrorBoundary}State {",
      "  hasError: boolean;",
      "  error: Error | null;",
      "}",
      "",
      "export class ${1:ErrorBoundary} extends React.Component<",
      "  ${1:ErrorBoundary}Props,",
      "  ${1:ErrorBoundary}State",
      "> {",
      "  constructor(props: ${1:ErrorBoundary}Props) {",
      "    super(props);",
      "    this.state = { hasError: false, error: null };",
      "  }",
      "",
      "  static getDerivedStateFromError(error: Error): ${1:ErrorBoundary}State {",
      "    return { hasError: true, error };",
      "  }",
      "",
      "  componentDidCatch(error: Error, errorInfo: React.ErrorInfo) {",
      "    handleError(error, { context: '${1:ErrorBoundary}', errorInfo });",
      "  }",
      "",
      "  render() {",
      "    if (this.state.hasError) {",
      "      const Fallback = this.props.fallback;",
      "      if (Fallback && this.state.error) {",
      "        return <Fallback error={this.state.error} />;",
      "      }",
      "",
      "      return (",
      "        <View style={{ padding: LAYOUT.SPACING.LARGE }}>",
      "          <Text>{STRINGS.ERROR_BOUNDARY_MESSAGE}</Text>",
      "        </View>",
      "      );",
      "    }",
      "",
      "    return this.props.children;",
      "  }",
      "}"
    ],
    "description": "Create an error boundary component"

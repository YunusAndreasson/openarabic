{
  "name": "openarabic",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "android": "expo start --android",
    "doctor": "npx expo-doctor",
    "format:check": "prettier --check  \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "ios": "expo start --ios",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix --resolve-plugins-relative-to .",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "start": "expo start",
    "test": "jest --watchAll --testTimeout=1000",
    "expoupgrade": "npx expo install",
    "types:db": "supabase gen types typescript --project-id kkmnzbeugdoajtzfjkxg > types/database.types.ts",
    "cleanup": "rm -rf node_modules/.cache node_modules/.vite .expo metro-cache .turbo build dist tmp coverage node_modules && pnpm install",
    "lint:fix:imports": "eslint . --ext .js,.jsx,.ts,.tsx --fix --rule 'import/order: [2, {\"groups\": [\"builtin\", \"external\", \"internal\", \"parent\", \"sibling\", \"index\"], \"newlines-between\": \"always\", \"alphabetize\": {\"order\": \"asc\"}}]'"
  },
  "dependencies": {

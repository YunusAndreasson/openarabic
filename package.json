    "expo-task-manager": "~58.0.12",
    "expo-updates": "~58.0.18",
    "mixpanel-react-native": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-audio-api": "0.13.6",
    "react-native-blob-util": "^0.24.0",
    "react-native-draggable-flatlist": "patch:react-native-draggable-flatlist@npm%3A4.0.3#~/.yarn/patches/react-native-draggable-flatlist-npm-4.0.3-4f5f75341e.patch",
    "react-native-executorch": "patch:react-native-executorch@npm%3A0.10.5#~/.yarn/patches/react-native-executorch-npm-0.10.5-ed40f33766.patch",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-sherpa-onnx": "patch:react-native-sherpa-onnx@npm%3A0.4.3#~/.yarn/patches/react-native-sherpa-onnx-npm-0.4.3-76c7ace0e3.patch",
    "react-native-skia": "3.7.4",
    "react-native-worklets": "0.13.0",

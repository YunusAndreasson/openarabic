{
  "name": "OpenArabic",
  "main": "expo-router/entry",
  "version": "1448.6.5+284",
  "description": "Read the classics in Arabic: the OpenArabic app for iPhone and Android.",
  "license": "MIT",
  "repository": "github:YunusAndreasson/openarabic",
  "homepage": "https://openarabic.io",
  "scripts": {
    "eas-build-pre-install": "corepack enable",
    "eas-build-post-install": "node scripts/check-runtime.js",
    "lint:fix": "eslint . --fix --cache",
    "lint": "eslint . --cache --max-warnings 0",
    "prettier:check": "prettier --check . --cache",
    "prettier:fix": "prettier --write . --cache",
    "start": "expo start -c",
    "dev": "./scripts/dev-android.sh",
    "test": "jest --onlyChanged --bail=1",
    "test:all": "jest --randomize --showSeed --forceExit",
    "test:watch": "jest --watch --maxWorkers=50%",
    "test:coverage": "jest --coverage --maxWorkers=100%",
    "test:unit": "jest --testPathPatterns='__tests__/(utils|constants)/'",
    "test:hooks": "jest --testPathPatterns='__tests__/hooks/'",
    "test:services": "jest --testPathPatterns='__tests__/services/'",
    "test:components": "jest --testPathPatterns='__tests__/components/'",
    "test:integration": "jest --testPathPatterns='__tests__/(app|integration)/'",
    "deps:check": "bash ./scripts/update-deps.sh",
    "deps:update": "bash ./scripts/update-deps.sh --apply",
    "deps:update:latest": "bash ./scripts/update-deps.sh --apply --latest",
    "fullupgrade": "yarn deps:update:latest",
    "types:db": "supabase gen types typescript --project-id kkmnzbeugdoajtzfjkxg > types/database.types.ts",
    "check-unused": "knip",
    "api:check": "node ./scripts/check-deprecated-apis.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:source": "yarn typecheck",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "lint:source": "yarn lint",
    "lint:tests": "eslint -c eslint.tests.config.mjs --no-inline-config --cache --cache-location .eslintcache-tests __tests__",
    "validate": "node scripts/validate-changed.js",
    "validate:full": "yarn typecheck && yarn typecheck:tests && yarn lint && yarn lint:tests && yarn api:check && yarn check-unused",
    "verify": "yarn runtime:check && yarn validate:full && yarn test:all",
    "runtime:check": "node scripts/check-runtime.js",
    "runtime:record": "node scripts/check-runtime.js --record",
    "bump": "node scripts/bumpVersion.js",
    "release": "gh workflow run release.yml",
    "release:all": "gh workflow run release.yml -f platform=all",
    "release:ios": "gh workflow run release.yml -f platform=ios",
    "release:android": "gh workflow run release.yml -f platform=android",
    "ota": "bash scripts/eas-update.sh"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.15",
    "@dr.pogodin/react-native-fs": "^2.41.0",
    "@expo-google-fonts/material-symbols": "^0.4.54",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/ui": "~58.0.29",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@kesha-antonov/react-native-background-downloader": "^4.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.1",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@react-native-vector-icons/ionicons": "^14.0.0",
    "@reduxjs/toolkit": "^2.15.0",
    "@sentry/react-native": "~8.28.0",
    "@shopify/flash-list": "2.3.2",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/query-async-storage-persister": "^5.108.2",
    "@tanstack/react-query": "^5.108.2",
    "@tanstack/react-query-persist-client": "^5.108.2",
    "culori": "^4.0.2",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-background-task": "~58.0.13",
    "expo-blur": "~58.0.6",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-store-review": "~58.0.3",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.14",
    "expo-updates": "~58.0.22",
    "expo-widgets": "patch:expo-widgets@npm%3A58.0.29#~/.yarn/patches/expo-widgets-npm-58.0.29.patch",
    "mixpanel-react-native": "^4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-audio-api": "1.0.1",
    "react-native-blob-util": "^1.1.1",
    "react-native-draggable-flatlist": "patch:react-native-draggable-flatlist@npm%3A4.0.3#~/.yarn/patches/react-native-draggable-flatlist-npm-4.0.3-4f5f75341e.patch",
    "react-native-executorch": "0.11.1",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-sherpa-onnx": "patch:react-native-sherpa-onnx@npm%3A0.4.4#~/.yarn/patches/react-native-sherpa-onnx-npm-0.4.4-fa7f8c174b.patch",
    "react-native-skia": "3.11.0",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.3.1",
    "redux-persist": "^6.0.0",
    "ts-fsrs": "^6.0.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@expo/agent-cli": "^1.0.32",
    "@jest/globals": "30.5.2",
    "@react-native/jest-preset": "0.88.1",
    "@swmansion/argent": "^0.34.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/culori": "^4.0.1",
    "@types/jest": "30.0.0",
    "@types/moment-hijri": "^2.1.4",
    "@types/react": "~19.3.0",
    "eslint": "10.15.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-perf": "^3.4.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.11.0",
    "globals": "^17.14.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "knip": "^6.47.0",
    "moment-hijri": "^3.0.0",
    "prettier": "^3.10.1",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "react-native-executorch": {
    "features": [
      "vad"
    ]
  },
  "private": true,
  "resolutions": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "glob@npm:^10.4.1": "^14.0.6",
    "glob@npm:^13.0.6": "^14.0.6",
    "jest-environment-jsdom": "^30.0.0",
    "jest-environment-node": "^30.0.0",
    "jest-mock": "^30.0.0",
    "minimatch@npm:^10.2.2": "^11.0.9",
    "minimatch@npm:^10.2.6": "^11.0.9",
    "react-native-screens": "~4.30.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0",
    "yarn": ">=4.0.0"
  },
  "packageManager": "yarn@4.18.0",
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "react-test-renderer",
        "jest",
        "@types/jest"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@babel/runtime",
          "@tanstack/query-async-storage-persister",
          "@tanstack/react-query-persist-client",
          "ts-fsrs",
          "redux-persist"
        ],
        "listUnknownPackages": false
      }
    }
  }
}

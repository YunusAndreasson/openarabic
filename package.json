{
  "name": "OpenArabic",
  "main": "expo-router/entry",
  "version": "1448.2.16+253",
  "scripts": {
    "postinstall": "patch-package",
    "lint:fix": "eslint . --fix --cache",
    "lint": "eslint . --cache",
    "prettier:check": "prettier --check . --cache",
    "prettier:fix": "prettier --write . --cache",
    "start": "expo start -c",
    "dev": "./scripts/dev-android.sh",
    "test": "jest --onlyChanged --maxWorkers=75% --testTimeout=10000",
    "test:all": "jest --maxWorkers=75% --testTimeout=10000",
    "test:changed": "jest --onlyChanged --maxWorkers=75% --testTimeout=10000",
    "test:watch": "jest --watch --maxWorkers=50% --testTimeout=10000",
    "test:coverage": "jest --coverage --maxWorkers=100% --testTimeout=10000",
    "test:unit": "jest --testPathPattern='utils|constants' --maxWorkers=75% --testTimeout=10000",
    "test:hooks": "jest --testPathPattern='hooks' --maxWorkers=75% --testTimeout=10000",
    "test:services": "jest --testPathPattern='services' --maxWorkers=75% --testTimeout=10000",
    "test:components": "jest --testPathPattern='components' --maxWorkers=75% --testTimeout=10000",
    "test:integration": "jest --testPathPattern='app|integration' --maxWorkers=75% --testTimeout=10000",
    "deps:check": "bash ./scripts/update-deps.sh",
    "deps:update": "bash ./scripts/update-deps.sh --apply",
    "deps:update:latest": "bash ./scripts/update-deps.sh --apply --latest",
    "fullupgrade": "yarn deps:update:latest",
    "types:db": "supabase gen types typescript --project-id kkmnzbeugdoajtzfjkxg > types/database.types.ts",
    "check-unused": "knip --exclude dependencies",
    "typecheck": "tsc --noEmit",
    "typecheck:source": "tsc --noEmit --skipLibCheck",
    "lint:source": "eslint . --cache",
    "prettier:check:source": "prettier --check . --cache",
    "validate": "node scripts/validate-changed.js",
    "validate:full": "yarn typecheck:source && yarn lint:source && yarn check-unused",
    "ci": "yarn validate:full && yarn test:all",
    "verify": "yarn ci",
    "bump": "node utils/bumpVersion.js",
    "release": "gh workflow run release.yml",
    "release:all": "gh workflow run release.yml -f platform=all",
    "release:ios": "gh workflow run release.yml -f platform=ios",
    "release:android": "gh workflow run release.yml -f platform=android",
    "ota": "eas update --branch production --environment production --platform ios --message",
    "ota:android": "eas update --branch production --environment production --platform android --message",
    "ota:all": "eas update --branch production --environment production --platform all --message"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@dr.pogodin/react-native-fs": "^2.39.2",
    "@expo/metro-runtime": "~57.0.8",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "^2.10.0",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "culori": "^4.0.2",
    "expo": "~57.0.11",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.9",
    "expo-audio": "~57.0.3",
    "expo-background-task": "~57.0.8",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.9",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-picker": "~57.0.8",
    "expo-linking": "~57.0.5",
    "expo-navigation-bar": "~57.0.2",
    "expo-notifications": "~57.0.9",
    "expo-router": "~57.0.11",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-task-manager": "~57.0.8",
    "expo-updates": "~57.0.12",
    "mixpanel-react-native": "^3.5.0",
    "moment-hijri": "^3.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-audio-api": "0.13.2",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-sherpa-onnx": "^0.4.3",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@react-native/jest-preset": "0.86.1",
    "@swmansion/argent": "^0.19.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/culori": "^4.0.1",
    "@types/jest": "30.0.0",
    "@types/moment-hijri": "^2.1.4",
    "@types/react": "~19.2.17",
    "eslint": "10.8.0",
    "eslint-config-expo": "~57.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.9.0",
    "globals": "^17.7.0",
    "jest": "~30.4.2",
    "jest-expo": "~57.0.3",
    "knip": "^6.29.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "private": true,
  "resolutions": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-environment-node": "^30.0.0",
    "jest-mock": "^30.0.0",
    "react-native-screens": "4.26.2"
  },
  "engines": {
    "node": ">=20.19.5",
    "yarn": ">=1.22.22"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@1.22.22",
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "react-test-renderer",
        "@shopify/react-native-skia",
        "jest",
        "@types/jest"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@babel/runtime",
          "@tanstack/query-async-storage-persister",
          "@tanstack/react-query-persist-client",
          "moment-hijri",
          "ts-fsrs",
          "redux-persist"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
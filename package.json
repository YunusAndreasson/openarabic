{
  "name": "OpenArabic",
  "main": "expo-router/entry",
  "version": "1447.10.1+221",
  "scripts": {
    "postinstall": "patch-package",
    "lint:fix": "eslint . --fix --cache",
    "lint": "eslint . --cache",
    "prettier:check": "prettier --check . --cache",
    "prettier:fix": "prettier --write . --cache",
    "start": "expo start -c",
    "test": "jest --onlyChanged --maxWorkers=75% --testTimeout=10000",
    "test:all": "jest --maxWorkers=75% --testTimeout=10000",
    "test:changed": "jest --onlyChanged --maxWorkers=75% --testTimeout=10000",
    "test:watch": "jest --watch --maxWorkers=50% --testTimeout=10000",
    "test:coverage": "jest --coverage --maxWorkers=100% --testTimeout=10000",
    "test:unit": "jest --testPathPattern='utils|constants' --maxWorkers=75% --testTimeout=10000",
    "test:hooks": "jest --testPathPattern='hooks' --maxWorkers=75% --testTimeout=10000",
    "test:services": "jest --testPathPattern='services' --maxWorkers=75% --testTimeout=10000",
    "test:components": "jest --testPathPattern='components' --maxWorkers=75% --testTimeout=10000",
    "test:integration": "jest --testPathPattern='app|integration' --maxWorkers=75% --testTimeout=10000",
    "fullupgrade": "yarn upgrade --latest && npx expo@latest install --check",
    "types:db": "supabase gen types typescript --project-id kkmnzbeugdoajtzfjkxg > types/database.types.ts",
    "check-unused": "knip --exclude dependencies",
    "typecheck": "tsc --noEmit",
    "typecheck:source": "tsc --noEmit --skipLibCheck",
    "lint:source": "eslint . --cache",
    "prettier:check:source": "prettier --check . --cache",
    "validate": "node scripts/validate-changed.js",
    "validate:full": "yarn typecheck:source && yarn lint:source && yarn check-unused",
    "ci": "yarn validate:full && yarn test:all",
    "bump": "node utils/bumpVersion.js",
    "release": "gh workflow run release.yml",
    "release:all": "gh workflow run release.yml -f platform=all",
    "release:ios": "gh workflow run release.yml -f platform=ios",
    "release:android": "gh workflow run release.yml -f platform=android"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@expo/metro-runtime": "^55.0.6",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-community/slider": "5.1.2",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/elements": "^2.9.11",
    "@react-navigation/native": "^7.1.34",
    "@react-navigation/native-stack": "^7.14.6",
    "@reduxjs/toolkit": "^2.11.2",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.4.18",
    "@supabase/supabase-js": "^2.99.3",
    "@tanstack/query-async-storage-persister": "^5.90.27",
    "@tanstack/react-query": "^5.91.3",
    "@tanstack/react-query-persist-client": "^5.90.27",
    "culori": "^4.0.2",
    "expo": "~55.0.8",
    "expo-application": "^55.0.10",
    "expo-asset": "^55.0.10",
    "expo-audio": "~55.0.9",
    "expo-background-task": "~55.0.10",
    "expo-blur": "~55.0.10",
    "expo-crypto": "^55.0.10",
    "expo-file-system": "^55.0.11",
    "expo-font": "^55.0.4",
    "expo-glass-effect": "^55.0.8",
    "expo-haptics": "^55.0.9",
    "expo-image": "^55.0.6",
    "expo-image-picker": "~55.0.13",
    "expo-linking": "^55.0.8",
    "expo-navigation-bar": "~55.0.9",
    "expo-notifications": "55.0.13",
    "expo-router": "^55.0.7",
    "expo-splash-screen": "~55.0.12",
    "expo-status-bar": "~55.0.4",
    "expo-store-review": "~55.0.9",
    "expo-system-ui": "~55.0.10",
    "expo-task-manager": "^55.0.10",
    "expo-updates": "^55.0.15",
    "mixpanel-react-native": "^3.3.0",
    "moment-hijri": "^3.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-worklets": "0.7.2",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "ts-fsrs": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.3",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.3.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/culori": "^4.0.1",
    "@types/jest": "29.5.14",
    "@types/moment-hijri": "^2.1.4",
    "@types/react": "~19.2.14",
    "eslint": "10.1.0",
    "eslint-config-expo": "^55.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "expo": "55.0.6",
    "fast-check": "^4.6.0",
    "globals": "^17.4.0",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.11",
    "knip": "^6.0.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.7.4",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.1"
  },
  "private": true,
  "resolutions": {
    "@react-native-async-storage/async-storage": "^2.2.0"
  },
  "engines": {
    "node": ">=20.19.5",
    "yarn": ">=1.22.22"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@1.22.22",
  "reanimated": {
    "staticFeatureFlags": {
      "USE_COMMIT_HOOK_ONLY_FOR_REACT_COMMITS": true,
      "USE_SYNCHRONIZABLE_FOR_MUTABLES": true,
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@babel/runtime",
          "@tanstack/query-async-storage-persister",
          "@tanstack/react-query-persist-client",
          "moment-hijri",
          "ts-fsrs",
          "redux-persist"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
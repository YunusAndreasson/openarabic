    "knip": "^5.46.5",
    "prettier": "^3.5.3",
    "react-test-renderer": "19.0.0",
    "redux-devtools-expo-dev-plugin": "^1.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "private": true,
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }

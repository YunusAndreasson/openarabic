{
  "name": "OpenArabic",
  "main": "expo-router/entry",
  "version": "1447.1.7+29",
  "scripts": {
    "postinstall": "patch-package",
    "doctor": "npx expo-doctor",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "start": "expo start -c",
    "test": "jest --testTimeout=10000",
    "test:watch": "jest --watchAll --testTimeout=10000",
    "test:coverage": "jest --coverage --testTimeout=10000",
    "fullupgrade": "yarn upgrade --latest && npx expo@latest install --check",
    "types:db": "supabase gen types typescript --project-id kkmnzbeugdoajtzfjkxg > types/database.types.ts",
    "knip:dev": "knip",
    "knip:ci": "knip --exclude duplicates",
    "knip:production": "knip --production",
    "typecheck": "tsc --noEmit",
    "validate": "yarn typecheck && yarn lint:fix && yarn knip:ci",
    "ci": "yarn validate && yarn test:coverage",
    "bump": "node utils/bumpVersion.js",
    "release": "gh workflow run release.yml",
    "dev": "yarn start",
    "build:check": "yarn validate && yarn test",
    "reassure": "reassure",
    "ai:check": "echo '🤖 AI Agent Pre-Check' && yarn validate && yarn test --passWithNoTests",
    "ai:test:specific": "jest --testNamePattern",
    "ai:lint:component": "eslint components/",
    "ai:lint:hooks": "eslint hooks/",
    "ai:typecheck:fast": "tsc --noEmit --incremental",
    "ai:validate:fast": "yarn ai:typecheck:fast && yarn lint:fix",
    "ai:performance": "yarn reassure --baseline && yarn reassure",
    "ai:clean": "rm -rf node_modules/.cache .jest-cache coverage && yarn install",
    "ai:parallel": "concurrently \"yarn typecheck\" \"yarn lint:fix\" \"yarn test --passWithNoTests\"",
    "ai:debug": "yarn test --verbose --no-coverage"
  },
  "dependencies": {
    "@babel/runtime": "^7.27.6",
    "@expo/vector-icons": "^14.1.0",
    "@gorhom/bottom-sheet": "^5.1.6",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-community/slider": "4.5.6",
    "@react-navigation/elements": "^2.5.2",
    "@react-navigation/native": "^7.1.14",
    "@react-navigation/native-stack": "^7.3.21",
    "@reduxjs/toolkit": "^2.8.2",
    "@sentry/react-native": "~6.14.0",
    "@shopify/flash-list": "1.7.6",
    "@shopify/react-native-skia": "2.0.0-next.4",
    "@supabase/supabase-js": "^2.50.3",
    "@tanstack/query-async-storage-persister": "^5.81.5",
    "@tanstack/react-query": "^5.81.5",
    "@tanstack/react-query-persist-client": "^5.81.5",
    "expo-asset": "^11.1.7",
    "expo-audio": "~0.4.8",
    "expo-blur": "^14.1.5",
    "expo-constants": "^17.1.7",
    "expo-crypto": "~14.1.5",
    "expo-file-system": "^18.1.11",
    "expo-font": "^13.3.2",
    "expo-haptics": "^14.1.4",
    "expo-image": "^2.3.2",
    "expo-image-picker": "~16.1.4",
    "expo-linear-gradient": "^14.1.5",
    "expo-linking": "^7.1.7",
    "expo-mail-composer": "~14.1.5",
    "expo-notifications": "~0.31.4",
    "expo-router": "^5.1.3",
    "expo-splash-screen": "^0.30.10",
    "expo-status-bar": "^2.2.3",
    "expo-system-ui": "^5.0.10",
    "expo-updates": "^0.28.16",
    "moment-hijri": "^3.0.0",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "strip-ansi": "^7.1.0",
    "ts-fsrs": "^5.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/plugin-transform-runtime": "^7.28.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.30.1",
    "@expo/metro-config": "^0.20.17",
    "@jest/globals": "^30.0.4",
    "@sentry/cli": "^2.46.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.0.10",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~13.0.0",
    "concurrently": "^9.2.0",
    "eslint": "9.30.1",
    "eslint-config-expo": "~9.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "expo": "^53.0.17",
    "jest": "~29.7.0",
    "jest-expo": "^53.0.9",
    "knip": "^5.61.3",
    "metro-react-native-babel-preset": "^0.77.0",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "react-test-renderer": "19.0.0",
    "reassure": "^1.4.0",
    "typescript": "^5.8.3"
  },
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=1.22.22"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@1.22.22",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@babel/runtime",
          "@tanstack/query-async-storage-persister",
          "@tanstack/react-query-persist-client",
          "moment-hijri",
          "strip-ansi",
          "ts-fsrs",
          "redux-persist"
        ],
        "listUnknownPackages": false
      }
    }
  }
}

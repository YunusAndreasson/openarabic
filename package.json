{
  "name": "OpenArabic",
  "main": "expo-router/entry",
  "version": "1447.7.7+211",
  "scripts": {
    "postinstall": "patch-package",
    "lint:fix": "eslint . --fix --cache",
    "lint": "eslint . --cache",
    "prettier:check": "prettier --check . --cache",
    "prettier:fix": "prettier --write . --cache",
    "start": "expo start -c",
    "test": "jest --onlyChanged --maxWorkers=75% --testTimeout=10000",
    "test:all": "jest --maxWorkers=75% --testTimeout=10000",
    "test:changed": "jest --onlyChanged --maxWorkers=75% --testTimeout=10000",
    "test:watch": "jest --watch --maxWorkers=50% --testTimeout=10000",
    "test:coverage": "jest --coverage --maxWorkers=100% --testTimeout=10000",
    "test:unit": "jest --testPathPattern='utils|constants' --maxWorkers=75% --testTimeout=10000",
    "test:hooks": "jest --testPathPattern='hooks' --maxWorkers=75% --testTimeout=10000",
    "test:services": "jest --testPathPattern='services' --maxWorkers=75% --testTimeout=10000",
    "test:components": "jest --testPathPattern='components' --maxWorkers=75% --testTimeout=10000",
    "test:integration": "jest --testPathPattern='app|integration' --maxWorkers=75% --testTimeout=10000",
    "fullupgrade": "yarn upgrade --latest && npx expo@latest install --check",
    "types:db": "supabase gen types typescript --project-id kkmnzbeugdoajtzfjkxg > types/database.types.ts",
    "check-unused": "knip --exclude dependencies",
    "typecheck": "tsc --noEmit",
    "typecheck:source": "tsc --noEmit --skipLibCheck",
    "lint:source": "eslint . --cache",
    "prettier:check:source": "prettier --check . --cache",
    "validate": "node scripts/validate-changed.js",
    "validate:full": "yarn typecheck:source && yarn lint:source && yarn check-unused",
    "ci": "yarn validate:full && yarn test:all",
    "bump": "node utils/bumpVersion.js",
    "release": "gh workflow run release.yml",
    "release:all": "gh workflow run release.yml -f platform=all",
    "release:ios": "gh workflow run release.yml -f platform=ios",
    "release:android": "gh workflow run release.yml -f platform=android"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@expo/metro-runtime": "^6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@invertase/react-native-apple-authentication": "^2.5.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-community/slider": "5.0.1",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@react-navigation/elements": "^2.9.3",
    "@react-navigation/native": "^7.1.26",
    "@react-navigation/native-stack": "^7.9.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@sentry/react-native": "~7.2.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.2.12",
    "@supabase/supabase-js": "^2.89.0",
    "@tanstack/query-async-storage-persister": "^5.90.18",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-persist-client": "^5.90.18",
    "culori": "^4.0.2",
    "expo-application": "^7.0.8",
    "expo-asset": "^12.0.12",
    "expo-audio": "~1.1.1",
    "expo-background-task": "~1.0.10",
    "expo-constants": "^18.0.12",
    "expo-crypto": "^15.0.8",
    "expo-file-system": "^19.0.21",
    "expo-font": "^14.0.10",
    "expo-haptics": "^15.0.8",
    "expo-image": "^3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "^8.0.11",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "0.32.15",
    "expo-router": "^6.0.21",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "^14.0.9",
    "expo-updates": "^29.0.15",
    "mixpanel-react-native": "^3.1.3",
    "moment-hijri": "^3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "ts-fsrs": "^5.2.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@eslint/js": "^9.39.2",
    "@jest/globals": "^30.2.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/culori": "^4.0.1",
    "@types/jest": "30.0.0",
    "@types/moment-hijri": "^2.1.4",
    "@types/react": "~19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "babel-preset-expo": "^54.0.9",
    "eslint": "9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "expo": "54.0.30",
    "fast-check": "^4.5.3",
    "jest": "~30.2.0",
    "jest-expo": "~54.0.16",
    "knip": "^5.79.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.7.4",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.3"
  },
  "private": true,
  "resolutions": {
    "@react-native-async-storage/async-storage": "^2.2.0"
  },
  "engines": {
    "node": ">=20.19.5",
    "yarn": ">=1.22.22"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@1.22.22",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@babel/runtime",
          "@tanstack/query-async-storage-persister",
          "@tanstack/react-query-persist-client",
          "moment-hijri",
          "ts-fsrs",
          "redux-persist"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
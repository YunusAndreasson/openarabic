{
  "name": "OpenArabic",
  "main": "expo-router/entry",
  "version": "1448.5.8+281",
  "scripts": {
    "eas-build-pre-install": "corepack enable",
    "lint:fix": "eslint . --fix --cache",
    "lint": "eslint . --cache --max-warnings 0",
    "prettier:check": "prettier --check . --cache",
    "prettier:fix": "prettier --write . --cache",
    "start": "expo start -c",
    "dev": "./scripts/dev-android.sh",
    "test": "jest --onlyChanged --bail=1",
    "test:all": "jest --randomize --showSeed --forceExit",
    "test:watch": "jest --watch --maxWorkers=50%",
    "test:coverage": "jest --coverage --maxWorkers=100%",
    "test:unit": "jest --testPathPatterns='__tests__/(utils|constants)/'",
    "test:hooks": "jest --testPathPatterns='__tests__/hooks/'",
    "test:services": "jest --testPathPatterns='__tests__/services/'",
    "test:components": "jest --testPathPatterns='__tests__/components/'",
    "test:integration": "jest --testPathPatterns='__tests__/(app|integration)/'",
    "deps:check": "bash ./scripts/update-deps.sh",
    "deps:update": "bash ./scripts/update-deps.sh --apply",
    "deps:update:latest": "bash ./scripts/update-deps.sh --apply --latest",
    "fullupgrade": "yarn deps:update:latest",
    "types:db": "supabase gen types typescript --project-id kkmnzbeugdoajtzfjkxg > types/database.types.ts",
    "check-unused": "knip",
    "api:check": "node ./scripts/check-deprecated-apis.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:source": "yarn typecheck",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "lint:source": "yarn lint",
    "lint:tests": "eslint -c eslint.tests.config.mjs --no-inline-config --cache --cache-location .eslintcache-tests __tests__",
    "validate": "node scripts/validate-changed.js",
    "validate:full": "yarn typecheck && yarn typecheck:tests && yarn lint && yarn lint:tests && yarn api:check && yarn check-unused",
    "verify": "yarn validate:full && yarn test:all",
    "bump": "node scripts/bumpVersion.js",
    "release": "gh workflow run release.yml",
    "release:all": "gh workflow run release.yml -f platform=all",
    "release:ios": "gh workflow run release.yml -f platform=ios",
    "release:android": "gh workflow run release.yml -f platform=android",
    "ota": "eas update --branch production --environment production --platform ios --message",
    "ota:android": "eas update --branch production --environment production --platform android --message",
    "ota:all": "eas update --branch production --environment production --platform all --message"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@dr.pogodin/react-native-fs": "^2.41.0",

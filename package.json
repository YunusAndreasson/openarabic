{
  "name": "OpenArabic",
  "main": "expo-router/entry",
  "version": "1447.12.12+237",
  "scripts": {
    "postinstall": "patch-package",
    "lint:fix": "eslint . --fix --cache",
    "lint": "eslint . --cache",
    "prettier:check": "prettier --check . --cache",
    "prettier:fix": "prettier --write . --cache",
    "start": "expo start -c",
    "dev": "./scripts/dev-android.sh",
    "test": "jest --onlyChanged --maxWorkers=75% --testTimeout=10000",
    "test:all": "jest --maxWorkers=75% --testTimeout=10000",
    "test:changed": "jest --onlyChanged --maxWorkers=75% --testTimeout=10000",
    "test:watch": "jest --watch --maxWorkers=50% --testTimeout=10000",
    "test:coverage": "jest --coverage --maxWorkers=100% --testTimeout=10000",
    "test:unit": "jest --testPathPattern='utils|constants' --maxWorkers=75% --testTimeout=10000",
    "test:hooks": "jest --testPathPattern='hooks' --maxWorkers=75% --testTimeout=10000",
    "test:services": "jest --testPathPattern='services' --maxWorkers=75% --testTimeout=10000",
    "test:components": "jest --testPathPattern='components' --maxWorkers=75% --testTimeout=10000",
    "test:integration": "jest --testPathPattern='app|integration' --maxWorkers=75% --testTimeout=10000",
    "fullupgrade": "yarn upgrade --latest && npx expo install --fix && yarn add --dev react-test-renderer@$(node -p \"require('./package.json').dependencies.react\")",
    "types:db": "supabase gen types typescript --project-id kkmnzbeugdoajtzfjkxg > types/database.types.ts",
    "check-unused": "knip --exclude dependencies",
    "typecheck": "tsc --noEmit",
    "typecheck:source": "tsc --noEmit --skipLibCheck",
    "lint:source": "eslint . --cache",
    "prettier:check:source": "prettier --check . --cache",
    "validate": "node scripts/validate-changed.js",
    "validate:full": "yarn typecheck:source && yarn lint:source && yarn check-unused",
    "ci": "yarn validate:full && yarn test:all",
    "bump": "node utils/bumpVersion.js",
    "release": "gh workflow run release.yml",
    "release:all": "gh workflow run release.yml -f platform=all",
    "release:ios": "gh workflow run release.yml -f platform=ios",
    "release:android": "gh workflow run release.yml -f platform=android",
    "ota": "eas update --branch production --environment production --platform ios --message",
    "ota:android": "eas update --branch production --environment production --platform android --message",
    "ota:all": "eas update --branch production --environment production --platform all --message"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@dr.pogodin/react-native-fs": "^2.38.2",
    "@expo/metro-runtime": "^56.0.15",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.4",
    "@supabase/supabase-js": "^2.108.1",
    "@tanstack/query-async-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "culori": "^4.0.2",
    "expo": "~56.0.11",
    "expo-application": "^56.0.3",
    "expo-asset": "^56.0.17",
    "expo-audio": "~56.0.12",
    "expo-background-task": "~56.0.18",
    "expo-blur": "~56.0.3",
    "expo-constants": "~56.0.18",
    "expo-crypto": "^56.0.4",
    "expo-dev-client": "~56.0.20",
    "expo-file-system": "^56.0.8",
    "expo-font": "^56.0.6",
    "expo-glass-effect": "^56.0.4",
    "expo-haptics": "^56.0.3",
    "expo-image": "^56.0.11",
    "expo-image-picker": "~56.0.17",
    "expo-linking": "^56.0.14",
    "expo-navigation-bar": "~56.0.3",
    "expo-notifications": "56.0.17",
    "expo-router": "^56.2.10",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-store-review": "~56.0.3",
    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "^56.0.18",
    "expo-updates": "^56.0.19",
    "mixpanel-react-native": "^3.3.0",
    "moment-hijri": "^3.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-audio-api": "0.12.2",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-sherpa-onnx": "^0.4.3",
    "react-native-worklets": "0.8.3",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0",
    "ts-fsrs": "^5.4.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/culori": "^4.0.1",
    "@types/jest": "30.0.0",
    "@types/moment-hijri": "^2.1.4",
    "@types/react": "~19.2.17",
    "eslint": "10.5.0",
    "eslint-config-expo": "^56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.8.0",
    "globals": "^17.6.0",
    "jest": "~30.4.2",
    "jest-expo": "~56.0.5",
    "knip": "^6.16.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "private": true,
  "resolutions": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-environment-node": "^30.0.0",
    "jest-mock": "^30.0.0",
    "react-native-screens": "4.25.1"
  },
  "engines": {
    "node": ">=20.19.5",
    "yarn": ">=1.22.22"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@1.22.22",
  "reanimated": {
    "staticFeatureFlags": {
      "USE_COMMIT_HOOK_ONLY_FOR_REACT_COMMITS": true,
      "USE_SYNCHRONIZABLE_FOR_MUTABLES": true,
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "react-test-renderer",
        "@shopify/react-native-skia",
        "jest",
        "@types/jest"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@babel/runtime",
          "@tanstack/query-async-storage-persister",
          "@tanstack/react-query-persist-client",
          "moment-hijri",
          "ts-fsrs",
          "redux-persist"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
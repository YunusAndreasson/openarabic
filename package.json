{
  "name": "openarabic",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "android": "expo start --android",
    "doctor": "npx expo-doctor",
    "format:check": "prettier --check  \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "ios": "expo start --ios",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix --resolve-plugins-relative-to .",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "start": "expo start",
    "test": "jest --watchAll --testTimeout=1000",
    "test:ci": "jest --ci --testTimeout=1000",
    "test:all": "jest --no-watch --testTimeout=1000 \"__tests__/simple.test.js|__tests__/services/articles.test.ts|__tests__/services/categories.test.ts|__tests__/services/study_words.test.ts|__tests__/services/supabase.test.ts|__tests__/store/readingListSlice.test.ts|__tests__/store/themeSlice.test.ts|__tests__/store/settingsSlice.test.ts|__tests__/hooks/srs-principles.test.ts|__tests__/hooks/ease-factor-test.js|__tests__/hooks/srs-edge-cases.test.ts|__tests__/hooks/srs-loop-prevention.test.ts|__tests__/hooks/useSpacedRepetition.test.ts|__tests__/utils/vocabulary-stats.test.ts|__tests__/hooks/useSpacedRepetitionHook.test.tsx|__tests__/hooks/memoization-demo.js\"",
    "test:coverage": "jest --coverage --no-watch --testTimeout=1000 \"__tests__/simple.test.js|__tests__/services/articles.test.ts|__tests__/services/categories.test.ts|__tests__/services/study_words.test.ts|__tests__/services/supabase.test.ts|__tests__/store/readingListSlice.test.ts|__tests__/store/themeSlice.test.ts|__tests__/store/settingsSlice.test.ts|__tests__/hooks/srs-principles.test.ts|__tests__/hooks/ease-factor-test.js|__tests__/hooks/srs-edge-cases.test.ts|__tests__/hooks/srs-loop-prevention.test.ts|__tests__/hooks/useSpacedRepetition.test.ts|__tests__/utils/vocabulary-stats.test.ts|__tests__/hooks/useSpacedRepetitionHook.test.tsx|__tests__/hooks/memoization-demo.js\"",
    "test:srs": "jest \"(useSpacedRepetition|srs-principles|ease-factor-test|srs-edge-cases|srs-loop-prevention|vocabulary-stats)\" --verbose --no-watch --testTimeout=1000 --testPathIgnorePatterns=memoization-demo.js",
    "test:srs:coverage": "jest \"(useSpacedRepetition|srs-principles|ease-factor-test|srs-edge-cases|srs-loop-prevention|vocabulary-stats)\" --verbose --no-watch --coverage --testTimeout=1000 --testPathIgnorePatterns=memoization-demo.js",
    "test:srs-principles": "jest srs-principles.test.ts --verbose --no-watch --testTimeout=1000",
    "test:srs-edge-cases": "jest srs-edge-cases.test.ts --verbose --no-watch --testTimeout=1000",
    "test:srs-loop-prevention": "jest srs-loop-prevention.test.ts --verbose --no-watch --testTimeout=1000",
    "test:vocabulary-stats": "jest vocabulary-stats.test.ts --verbose --no-watch --testTimeout=1000",
    "test:quick": "jest --no-watch --testTimeout=500",
    "test:file": "node scripts/run-test-with-timeout.js",
    "test:animations": "jest --testPathPattern=__tests__/hooks/animations --testPathIgnorePatterns=__mocks__",
    "validate": "npm run lint && npm run format:check",
    "expoupgrade": "npx expo install --check",
    "web": "expo start --web",
    "knip": "knip",
    "knip:production": "knip --production",
    "knip:types": "knip --include types",
    "knip:files": "knip --include files",
    "knip:files:verbose": "knip --include files --verbose",
    "knip:islands": "knip --include files --no-config-hints"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/slider": "^4.5.5",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/elements": "^2.2.5",
    "@react-navigation/native": "^7.0.14",
    "@reduxjs/toolkit": "^2.5.1",
    "@shopify/react-native-skia": "1.5.0",
    "@supabase/supabase-js": "^2.48.1",
    "@tanstack/react-query": "^5.66.0",
    "expo": "~52.0.36",
    "expo-av": "~15.0.2",
    "expo-blur": "~14.0.3",
    "expo-constants": "~17.0.7",
    "expo-font": "~13.0.4",
    "expo-haptics": "~14.0.1",
    "expo-image": "~2.0.6",
    "expo-linear-gradient": "^14.0.2",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.17",
    "expo-splash-screen": "~0.29.21",
    "expo-status-bar": "~2.0.1",
    "expo-system-ui": "~4.0.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.7",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-toast-message": "^2.2.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.5",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.8",
    "@dev-plugins/react-query": "^0.1.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.18",
    "@types/react-test-renderer": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~8.0.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react-native": "^5.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-expo": "~52.0.5",
    "knip": "^5.45.0",
    "prettier": "^3.5.0",
    "react-test-renderer": "18.3.1",
    "redux-devtools-expo-dev-plugin": "^1.0.0",
    "ts-jest": "^29.2.6",
    "typescript": "^5.7.3"
  },
  "private": true,
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}

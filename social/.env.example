# OpenArabic social poster — credentials & config.
# Copy to social/.env (git-ignored) and fill in. run-post.sh sources this file.

# --- Supabase (READ-ONLY word data + Storage upload for public image URLs) ---
# The anon key is sufficient for reading roots/sentence_words and (per the
# existing publish/ scripts) uploading to the batch_scheduled Storage bucket.
SUPABASE_URL=https://kkmnzbeugdoajtzfjkxg.supabase.co
SUPABASE_ANON_KEY=
# Optional: only needed if the anon key cannot write to Storage.
# Found in admin-dashboard/.env.local as SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Public Storage bucket the rendered cards are uploaded to.
SOCIAL_BUCKET=batch_scheduled

# --- Instagram (Meta Graph API) ---
# IG_USER_ID: the Instagram *business* account id (numeric), obtained from
#   GET /{page-id}?fields=instagram_business_account
# IG_ACCESS_TOKEN: a long-lived / system-user token with
#   instagram_basic + instagram_content_publish on the linked Facebook Page.
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- X (Twitter) — OAuth 1.0a User Context, 4 static keys ---
# The app must have Read+Write; regenerate the access token AFTER enabling write.
# NOTE: attaching an image (media/upload) may require X's paid Basic tier.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Site / links ---
SITE_URL=https://openarabic.io

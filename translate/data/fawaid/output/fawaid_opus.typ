#block(width: 100%, inset: (x: 12pt, y: 6pt), fill: rgb("#f8f6f0"), radius: 3pt, stroke: 0.4pt + luma(220))[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  من الذَّاكِرِينَ من يبتديء بِذكر اللِّسَان وَإِن كَانَ على غَفلَة
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  Among those who remember #text(fill: luma(120))[\[God are\]] those who begin with remembrance of the tongue, even if #text(fill: luma(120))[\[they are\]] in heedlessness.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  ثمَّ لَا يزَال فِيهِ حَتَّى يحضر قلبه فيتواطئا على الذّكر
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  Then #text(fill: luma(120))[\[they\]] keep at it until their heart becomes present, and the two agree upon the remembrance.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

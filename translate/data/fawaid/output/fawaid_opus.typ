  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  When Adam sought eternal life in Paradise through the tree, he #text(fill: luma(120))[\[was\]] punished by being expelled from it.
]

#block(width: 100%, below: 0.2cm)[

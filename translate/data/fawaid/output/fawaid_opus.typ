  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  #text(fill: luma(120))[\[there\]] comes to you #text(fill: luma(120))[\[a\]] speech #text(fill: luma(120))[\[that\]] one never tires of hearing ... sweet to us #text(fill: luma(120))[\[is\]] its prose and its verse.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

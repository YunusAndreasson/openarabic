  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  فتذله نعم الله عَلَيْهِ وتكسره
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  So God's blessings upon him humble him and break him —
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  كسرة من لَا يرى لنَفسِهِ وَلَا فِيهَا خيرا البتّة
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))

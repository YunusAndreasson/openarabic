]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَهِي ثَلَاثَة أُمُور شرك وبدعة ومعصية
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And they #text(fill: luma(120))[\[are\]] three things: associating partners #text(fill: luma(120))[\[with God\]], innovation, and sin.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  فيزول عائق الشّرك بتجريد التَّوْحِيد
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  So the obstacle of associating partners #text(fill: luma(120))[\[with God\]] #text(fill: luma(120))[\[is\]] removed by purifying monotheism,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

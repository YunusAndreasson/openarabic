  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  and #text(fill: luma(120))[\[on one\]] side, while the people #text(fill: luma(120))[\[are\]] in #text(fill: luma(120))[\[another\]] direction and another side.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

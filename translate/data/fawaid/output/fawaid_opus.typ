  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  So this #text(fill: luma(120))[\[is\]] according to the life of the body, and that #text(fill: luma(120))[\[is\]] according to the life of the heart.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

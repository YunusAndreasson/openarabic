  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And this #text(fill: luma(120))[\[is\]] their root, and from it #text(fill: luma(120))[\[is\]] their derivation.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  فَإِن المشاقة أَن يكون فِي شقّ وَمن يُخَالِفهُ فِي شقّ
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  For opposition #text(fill: luma(120))[\[means\]] that he #text(fill: luma(120))[\[is\]] on one side, and whoever disagrees with him #text(fill: luma(120))[\[is\]] on #text(fill: luma(120))[\[another\]] side.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  والمحادة ان يكون حد وَهُوَ فِي حد
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And hostility #text(fill: luma(120))[\[means that one is\]] on one edge, and he #text(fill: luma(120))[\[is\]] on #text(fill: luma(120))[\[another\]] edge.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَلَا تستسهل هَذَا فَإِن مبادئه تجر إِلَى غَايَته وقليله يَدْعُو إِلَى كَثِيره
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And do not take this lightly, for its beginnings drag #text(fill: luma(120))[\[one\]] to its end, and its little calls to its much.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَكن فِي الْجَانِب الَّذِي يكون فِيهِ الله وَرَسُوله
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And be on the side on which God and His Messenger #text(fill: luma(120))[\[are\]],
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وان كَانَ النَّاس كلهم فِي الْجَانِب الآخر
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  even if all the people #text(fill: luma(120))[\[are\]] on the other side.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

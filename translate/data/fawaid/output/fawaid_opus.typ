  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  #text(fill: luma(120))[\[a\]] step away from his self, and #text(fill: luma(120))[\[a\]] step away from creation.

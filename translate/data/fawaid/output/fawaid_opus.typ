  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  such that the Hereafter #text(fill: luma(120))[\[is\]] more beloved to him than this world, and more preferred by him than it.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَيكون الله وَرَسُوله أحب إِلَيْهِ مِمَّا سواهُمَا
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And God and His Messenger #text(fill: luma(120))[\[are\]] more beloved to him than anything other than them.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَلَيْسَ شَيْء أصعب على الْإِنْسَان من ذَلِك فِي مبادىء الْأَمر
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And nothing #text(fill: luma(120))[\[is\]] harder on #text(fill: luma(120))[\[a\]] person than that at the beginning of the matter.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

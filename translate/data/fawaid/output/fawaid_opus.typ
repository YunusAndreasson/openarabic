  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And they knew that it #text(fill: luma(120))[\[is\]] #text(fill: luma(120))[\[a\]] crossing and #text(fill: luma(120))[\[a\]] passage, not #text(fill: luma(120))[\[a\]] place of staying and settling,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَأَنَّهَا دَار عبور لَا دَار سرُور
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  and that it #text(fill: luma(120))[\[is\]] #text(fill: luma(120))[\[a\]] place of passing, not #text(fill: luma(120))[\[a\]] place of joy,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

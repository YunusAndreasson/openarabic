  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And from its blessings #text(fill: luma(120))[\[is\]] that it carries the filth upon its back and brings out for you from its belly the most beautiful and useful things.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

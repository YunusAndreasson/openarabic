  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And if it does not weaken it, then engaging in it #text(fill: luma(120))[\[is\]] better.
]

#block(width: 100%, below: 0.2cm)[

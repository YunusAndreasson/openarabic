  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  Whoever knows his Lord #text(fill: luma(120))[\[is\]] busy with Him #text(fill: luma(120))[\[rather\]] than #text(fill: luma(120))[\[with\]] the desire of his self.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  أَنْفَع الْعَمَل أَن تغيب فِيهِ عَن النَّاس بالإخلاص وَعَن نَفسك بِشُهُود المنّة
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  The most beneficial deed #text(fill: luma(120))[\[is\]] that you disappear in it from people through sincerity, and from yourself through witnessing #text(fill: luma(120))[\[God's\]] favor.
]

#block(width: 100%, below: 0.2cm)[

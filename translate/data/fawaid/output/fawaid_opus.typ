  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And in #text(fill: luma(120))[\[another\]] wording: 'Praise #text(fill: luma(120))[\[be\]] to God who reduced his plot to #text(fill: luma(120))[\[mere\]] whispering.'

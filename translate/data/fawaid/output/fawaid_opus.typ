  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  For his self, his desire, his nature, his devil, his brothers, and his companions from that side call him to the immediate #text(fill: luma(120))[\[world\]].
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

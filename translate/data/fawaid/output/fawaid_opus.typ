  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  For He #text(fill: luma(120))[\[is\]] the One who decreed the cause and decreed the effect,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَهُوَ عدل فِي هَذَا الْقَضَاء
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  and He #text(fill: luma(120))[\[is\]] just in this decree.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَهَذَا الْقَضَاء خير لِلْمُؤمنِ
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And this decree #text(fill: luma(120))[\[is\]] good for the believer,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  كَمَا قَالَ وَالَّذِي نَفسِي بِيَدِهِ لَا يقْضِي الله لِلْمُؤمنِ قَضَاء إِلَّا كَانَ خيرا لَهُ

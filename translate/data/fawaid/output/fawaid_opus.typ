  ﴿﴿وَإِمَّا يَنْزَغَنَّكَ مِنَ الشَّيْطَانِ نَزْغٌ فَاسْتَعِذْ بِاللَّهِ إِنَّهُ سَمِيعٌ عَلِيمٌ﴾﴾
  #v(0.08cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(40))

  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  and the obstacle of innovation #text(fill: luma(120))[\[is removed\]] by holding to the Sunnah, and the obstacle of sin by correcting repentance.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

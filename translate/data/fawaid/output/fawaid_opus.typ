]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  سكن فِي الدُّنْيَا قبل الْآخِرَة فِي جنَّة لَا يشبه فِيهَا إِلَّا نعيم الْآخِرَة
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  he dwells in this world before the Hereafter in #text(fill: luma(120))[\[a\]] paradise that nothing resembles except the bliss of the Hereafter.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  فَإِنَّهُ لَا يزَال رَاضِيا عَن ربه
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  For he never ceases #text(fill: luma(120))[\[being\]] pleased with his Lord.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَالرِّضَا جنَّة الدُّنْيَا ومستراح العارفين
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And contentment #text(fill: luma(120))[\[is\]] the paradise of this world and the resting place of the knowers.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

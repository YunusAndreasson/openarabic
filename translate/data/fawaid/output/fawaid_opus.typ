]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  على لَذَّة عَظِيمَة دائمة أَبَد الآباد
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  over #text(fill: luma(120))[\[a\]] great, lasting pleasure for all eternity?
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَكَمَال العَبْد بِحَسب هَاتين القوتين الْعلم وَالْحب
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And the perfection of the servant #text(fill: luma(120))[\[is\]] according to these two powers: knowledge and love.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَأفضل الْعلم الْعلم بِاللَّه
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And the best knowledge #text(fill: luma(120))[\[is\]] knowledge of God,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَأَعْلَى الْحبّ الْحبّ لَهُ
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))

  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَمَا عدا ذَلِك من الْعُلُوم والإرادات والأعمال
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And whatever #text(fill: luma(120))[\[is\]] besides that — of knowledge, desires, and actions —
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  فَهِيَ بَين مَالا ينفعها وَلَا يكملها
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  it #text(fill: luma(120))[\[is\]] between what does not benefit it and does not perfect it,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَمَا يعود بضررها ونقصها وألمها
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))

#block(width: 100%, inset: (x: 12pt, y: 6pt), fill: rgb("#f8f6f0"), radius: 3pt, stroke: 0.4pt + luma(220))[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  ﴿﴿الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً وَالزَّانِيَةُ لَا يَنْكِحُهَا إِلَّا زَانٍ أَوْ مُشْرِكٌ وَحُرِّمَ ذَلِكَ عَلَى الْمُؤْمِنِينَ﴾﴾
  #v(0.08cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(40))

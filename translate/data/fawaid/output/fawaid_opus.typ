#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  صِحَة الْمعرفَة بِاللَّه وَأمره وأسمائه وَصِفَاته
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  the soundness of knowledge of God, and His command, and His names, and His attributes;
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَالثَّانِي تَجْرِيد الانقياد لَهُ وَلِرَسُولِهِ دون مَا سواهُ
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  and the second #text(fill: luma(120))[\[is\]] pure submission to Him and to His Messenger, apart from anything else.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  فَهَذَا أوثق أساس أسس العَبْد عَلَيْهِ بُنْيَانه
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  So this #text(fill: luma(120))[\[is\]] the firmest foundation the servant #text(fill: luma(120))[\[can\]] build his building upon,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وبحسبه يعتلي الْبناء مَا شَاءَ
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  and according to it the building rises as #text(fill: luma(120))[\[much as\]] it wills.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  فاحكم الأساس واحفظ الْقُوَّة وَدم على الحمية
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  So strengthen the foundation, and preserve #text(fill: luma(120))[\[your\]] strength, and stay on the diet,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  واستفرغ إِذا زَاد بك الْخَلْط
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  and purge #text(fill: luma(120))[\[yourself\]] when the bad mixture increases in you.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَالْقَصْد الْقَصْد وَقد بلغت المُرَاد
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And #text(fill: luma(120))[\[keep to\]] moderation, moderation — and you #text(fill: luma(120))[\[will\]] have reached what #text(fill: luma(120))[\[is\]] desired.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَإِلَّا فَمَا دَامَت الْقُوَّة ضَعِيفَة والمادة الْفَاسِدَة مَوْجُودَة والاستفراغ مَعْدُوما
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  Otherwise, as long as the strength #text(fill: luma(120))[\[is\]] weak, and the corrupt matter #text(fill: luma(120))[\[is\]] present, and purging #text(fill: luma(120))[\[is\]] absent —
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  فاقر السَّلَام على الْحَيَاة فَإِنَّهَا ... قد آذنتك بِسُرْعَة التوديع
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  then give farewell greetings to life, for it ... has warned you of #text(fill: luma(120))[\[a\]] quick departure.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  فَإِذا كمل الْبناء فبيضه بِحسن الْخلق وَالْإِحْسَان إِلَى النَّاس
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  So when the building #text(fill: luma(120))[\[is\]] complete, then whiten it with good character and kindness to people.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  ثمَّ حَظه بسور من الحذر لَا يقتحمه عَدو وَلَا تبدو مِنْهُ الْعَوْرَة
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  Then surround it with #text(fill: luma(120))[\[a\]] wall of caution that no enemy #text(fill: luma(120))[\[can\]] break through, and no weakness #text(fill: luma(120))[\[is\]] exposed from it.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  ثمَّ ارخ الستور على أبوابه
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  Then lower the curtains over its doors.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  ثمَّ أقفل الْبَاب الْأَعْظَم بِالسُّكُوتِ عَمَّا تخشى عاقبته
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  Then lock the greatest door with silence about what you fear its outcome.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  ثمَّ ركب لَهُ مفتاحا من ذكر الله بِهِ تفتحه وتغلقه
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  Then fit for it #text(fill: luma(120))[\[a\]] key from the remembrance of God — with it you open it and close it.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  فَإِن فتحت فتحت بالمفتاح وَإِن أغلقت الْبَاب أغلقته بِهِ
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  So if you open, you open with the key; and if you close the door, you close it with it.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  فَتكون حِينَئِذٍ قد بنيت حصنا تحصنت فِيهِ من أعدائك
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  Then you #text(fill: luma(120))[\[will\]] have built #text(fill: luma(120))[\[a\]] fortress #text(fill: luma(120))[\[in which\]] you #text(fill: luma(120))[\[have\]] fortified yourself from your enemies.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  إِذا طَاف بِهِ الْعَدو لم يجد مِنْهُ مدخلًا فييأس مِنْك
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  When the enemy circles around it, he #text(fill: luma(120))[\[will\]] not find an entrance into it, so he #text(fill: luma(120))[\[will\]] despair of you.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  ثمَّ تعاهد بِنَاء الْحصن كل وَقت
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  Then maintain the building of the fortress at all times,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  فَإِن الْعَدو إِذا لم يطْمع فِي الدُّخُول من الْبَاب نقّب عَلَيْك النقوب من بعيد بمعاول الذُّنُوب
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  for the enemy, if he does not hope to enter from the door, #text(fill: luma(120))[\[will\]] dig tunnels toward you from afar with the pickaxes of sins.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  فَإِن أهملت أمره وصل إِلَيْك النقب
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  So if you neglect his affair, the tunnel #text(fill: luma(120))[\[will\]] reach you,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  فَإِذا الْعَدو مَعَك فِي دَاخل الْحصن فيصعب عَلَيْك إِخْرَاجه
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  and then the enemy #text(fill: luma(120))[\[is\]] with you inside the fortress, and removing him #text(fill: luma(120))[\[will be\]] difficult for you,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَتَكون مَعَه على
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  and you #text(fill: luma(120))[\[will\]] be with him upon —
]

  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And in summary, gathering and mixing #text(fill: luma(120))[\[is a\]] pollination — either for the self that commands #text(fill: luma(120))[\[evil\]], or for the heart and the tranquil self.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  والنتيجة مستفادة من اللقَاح
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And the result #text(fill: luma(120))[\[is\]] gained from the pollination.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  فَمن طاب لقاحه طابت ثَمَرَته
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))

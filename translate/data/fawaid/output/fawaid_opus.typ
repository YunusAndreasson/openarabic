  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  #text(fill: luma(120))[\[is\]] it rising to that voluntary act even if his spiritual opening goes away,
]

#block(width: 100%, below: 0.2cm)[

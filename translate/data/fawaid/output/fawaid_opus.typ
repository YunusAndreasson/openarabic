  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  so how about the grief of #text(fill: luma(120))[\[a\]] lifetime?
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  مَحْبُوب الْيَوْم يعقب الْمَكْرُوه غَدا
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  What #text(fill: luma(120))[\[is\]] loved today #text(fill: luma(120))[\[is\]] followed by what #text(fill: luma(120))[\[is\]] hated tomorrow,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And advancement and racing to God, glorified #text(fill: luma(120))[\[is\]] He, #text(fill: luma(120))[\[is\]] only through aspirations, sincerity of desire, and resolve.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

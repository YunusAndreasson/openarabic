  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And #text(fill: luma(120))[\[the second is\]] the life of his heart and his spirit, by which he distinguishes between truth and falsehood, misguidance and right guidance, desire and straying.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

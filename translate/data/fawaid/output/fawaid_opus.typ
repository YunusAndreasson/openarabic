  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  For justice according to them #text(fill: luma(120))[\[is\]] everything that #text(fill: luma(120))[\[is\]] possible.
]

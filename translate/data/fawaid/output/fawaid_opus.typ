  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  ﴿وَلَئِنْ أَذَقْنَا الْإِنْسَانَ مِنَّا رَحْمَةً ثُمَّ نَزَعْنَاهَا مِنْهُ إِنَّهُ لَيَئُوسٌ كَفُورٌ﴾

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  دخل النَّاس النَّار من ثَلَاثَة أَبْوَاب
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  People entered the Fire through three doors:
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  بَاب شُبْهَة أورثت شكا فِي دين الله
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  #text(fill: luma(120))[\[a\]] door of doubt that produced uncertainty in the religion of God,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَبَاب شَهْوَة أورثت تَقْدِيم الْهوى على طَاعَته ومرضاته
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  and #text(fill: luma(120))[\[a\]] door of lust that produced putting desire above His obedience and His pleasure,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَبَاب غضب أورث الْعدوان على خلقه
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  and #text(fill: luma(120))[\[a\]] door of anger that produced aggression against His creation.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  أصُول الْخَطَايَا كلهَا ثَلَاثَة
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  The roots of all sins #text(fill: luma(120))[\[are\]] three:
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  الْكبر وَهُوَ الَّذِي أصار إِبْلِيس إِلَى مَا أصاره
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  arrogance — and it #text(fill: luma(120))[\[is\]] what brought Iblis to what it brought him to,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And God #text(fill: luma(120))[\[is\]] the One whose help #text(fill: luma(120))[\[is\]] sought.

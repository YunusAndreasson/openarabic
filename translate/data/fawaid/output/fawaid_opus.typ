  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And regarding it #text(fill: luma(120))[\[there are\]] two views. The first #text(fill: luma(120))[\[is\]] that rejecting it and disliking it #text(fill: luma(120))[\[is\]] pure faith.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَالثَّانِي أَن وجوده وإلقاء الشَّيْطَان لَهُ فِي النَّفس صَرِيح الْإِيمَان
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))

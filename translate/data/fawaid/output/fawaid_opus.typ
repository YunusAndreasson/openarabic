  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  and not leaving anything of the voluntary #text(fill: luma(120))[\[prayers\]] and daily devotions because of those spiritual states that the powers of humans #text(fill: luma(120))[\[are\]] unable to bear.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

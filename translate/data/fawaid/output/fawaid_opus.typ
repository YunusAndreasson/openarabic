  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  So he was — with his perfection, his will, and his states with God — standing #text(fill: luma(120))[\[in prayer\]] until his feet #text(fill: luma(120))[\[would\]] swell,
]

#block(width: 100%, below: 0.2cm)[

  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And God Most High commanded His servants to uphold the laws of Islam upon their outward #text(fill: luma(120))[\[selves\]], and the realities of faith upon their inward #text(fill: luma(120))[\[selves\]].
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

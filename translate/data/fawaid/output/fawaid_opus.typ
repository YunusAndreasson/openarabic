  The servant has #text(fill: luma(120))[\[a\]] Lord he #text(fill: luma(120))[\[will\]] meet, and #text(fill: luma(120))[\[a\]] house he #text(fill: luma(120))[\[will\]] dwell in.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

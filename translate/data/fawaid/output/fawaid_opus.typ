  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  The free woman starves and does not eat #text(fill: luma(120))[\[by means of\]] her breasts.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  لَا تسْأَل سوى مَوْلَاك
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  Do not ask #text(fill: luma(120))[\[anyone\]] other than your Master.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  فسؤال العَبْد غير سَيّده تشنيع عَلَيْهِ
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  For the servant asking other than his master #text(fill: luma(120))[\[is\]] a disgrace upon him.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  and striving in the path of God, and mixing with #text(fill: luma(120))[\[his\]] companions without hiding from them,
]

#block(width: 100%, below: 0.2cm)[

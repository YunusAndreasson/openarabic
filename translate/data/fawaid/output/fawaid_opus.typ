  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  I #text(fill: luma(120))[\[am\]] only like #text(fill: luma(120))[\[a\]] rider #text(fill: luma(120))[\[who\]] rested in the shade of #text(fill: luma(120))[\[a\]] tree, then left and abandoned it."
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَقَالَ مَا الدُّنْيَا فِي الْآخِرَة إِلَّا كَمَا يدْخل أحدكُم إصبعه فِي اليم
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And he said: "This world compared to the Hereafter #text(fill: luma(120))[\[is\]] nothing but like when one of you dips his finger in the sea —
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

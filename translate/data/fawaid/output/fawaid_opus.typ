  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  If #text(fill: luma(120))[\[a\]] foolish word comes out from your enemy, do not follow it with one like it #text(fill: luma(120))[\[that\]] fertilizes it.
]

#block(width: 100%, below: 0.2cm)[

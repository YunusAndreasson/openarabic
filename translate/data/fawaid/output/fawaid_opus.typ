  فَإِذا أَرَادَ قَضَاء حَاجَة وَاحِد من أُولَئِكَ
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  So when He wants to fulfill the need of one of those #text(fill: luma(120))[\[people\]],
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  أذن لبَعض جُلَسَائِهِ وخاصته أَن يشفع فِيهِ
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  He permits some of His companions and close ones to intercede for him —
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  رَحْمَة لَهُ وكرامة للشافع
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  #text(fill: luma(120))[\[as\]] a mercy to him and #text(fill: luma(120))[\[as\]] an honor for the intercessor.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَسَائِر النَّاس مطرودون عَن الْبَاب مضروبون بسياط العَبْد
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And the rest of the people #text(fill: luma(120))[\[are\]] driven away from the door, struck with the whips of the servant.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  فصل
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  Chapter
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  عشرَة أَشْيَاء ضائعة لَا ينْتَفع بهَا
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  Ten wasted things that bring no benefit:
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  علم لَا يعْمل بِهِ
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  knowledge that #text(fill: luma(120))[\[is\]] not acted upon,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَعمل لَا إخلاص فِيهِ وَلَا اقْتِدَاء
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  and deeds #text(fill: luma(120))[\[that have\]] no sincerity in them and no following #text(fill: luma(120))[\[of guidance\]],
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَمَال لَا ينْفق مِنْهُ فَلَا يسْتَمْتع بِهِ جَامعه فِي الدُّنْيَا وَلَا يقدمهُ
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  and wealth that #text(fill: luma(120))[\[is\]] not spent from — so its collector does not enjoy it in this world, nor does he send it forward.
]

  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And #text(fill: luma(120))[\[it is\]] known that the human being was not given #text(fill: luma(120))[\[the ability to\]] kill #text(fill: luma(120))[\[his\]] thoughts, nor the power to cut them off,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  As the Companions said: 'O Messenger of God, one of us finds in himself something that to burn until he becomes charcoal #text(fill: luma(120))[\[would be\]] more beloved to him than to speak of it.'
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

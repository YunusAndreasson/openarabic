  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And whoever He created for the Fire — its gifts keep coming to him through desires.
]

#block(width: 100%, below: 0.2cm)[

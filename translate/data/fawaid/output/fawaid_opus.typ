  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  For it #text(fill: luma(120))[\[is\]] the ease of the self with what befalls him of the decrees, which #text(fill: luma(120))[\[are\]] the very choice of God for him,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

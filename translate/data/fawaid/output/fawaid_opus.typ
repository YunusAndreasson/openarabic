  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  "Anger #text(fill: luma(120))[\[is\]] from Satan, and Satan #text(fill: luma(120))[\[is\]] from fire, and fire #text(fill: luma(120))[\[is\]] only put out with water.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

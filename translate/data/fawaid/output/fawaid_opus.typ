  Whoever knows himself #text(fill: luma(120))[\[is\]] busy with fixing himself #text(fill: luma(120))[\[rather\]] than #text(fill: luma(120))[\[with\]] the faults of people.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  and that He, glorified #text(fill: luma(120))[\[is\]] He, loves Himself and praises Himself and commends Himself
]


  #text(fill: luma(120))[\[that\]] is certainty for him, #text(fill: luma(120))[\[with\]] no doubt in him about it.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَإِلَى صَبر تَامّ على معاداة من عَادَاهُ ولومة من لامه
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And #text(fill: luma(120))[\[he needs\]] complete patience against the hostility of whoever opposes him, and the blame of whoever blames him.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وَلَا يتم لَهُ ذَلِك إِلَّا برغبة قَوِيَّة فِي الله وَالدَّار الْآخِرَة
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And that #text(fill: luma(120))[\[is\]] not complete for him except with #text(fill: luma(120))[\[a\]] strong desire for God and the Hereafter,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

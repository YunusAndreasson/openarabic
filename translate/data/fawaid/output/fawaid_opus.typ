#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  فرغ خاطرك للهم بِمَا أمرت بِهِ وَلَا تشغله بِمَا ضمن لَك
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  Free your mind to concern #text(fill: luma(120))[\[itself\]] with what you were commanded with, and do not occupy it with what #text(fill: luma(120))[\[has been\]] guaranteed for you.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  فَإِن الرزق وَالْأَجَل قرينان مضمونان
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  For provision and the lifespan #text(fill: luma(120))[\[are\]] two companions, #text(fill: luma(120))[\[both\]] guaranteed.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

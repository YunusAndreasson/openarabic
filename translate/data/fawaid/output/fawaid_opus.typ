  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  The first #text(fill: luma(120))[\[is\]] what #text(fill: luma(120))[\[comes\]] as repayment from Him to the servant for his turning away from Him,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

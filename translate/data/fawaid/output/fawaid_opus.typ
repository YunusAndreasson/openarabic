  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  and #text(fill: luma(120))[\[it\]] was from the Prophetic remembrances, and the one remembering witnessed its meanings and purposes.
]

#block(width: 100%, below: 0.2cm)[

  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And this #text(fill: luma(120))[\[is\]] a topic that needs detailed explanation, in which Islam and excellence #text(fill: luma(120))[\[are\]] brought together.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

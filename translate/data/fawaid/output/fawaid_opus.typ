  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  And his life #text(fill: luma(120))[\[is\]] in His hand, and his death #text(fill: luma(120))[\[is\]] in His hand, and his happiness #text(fill: luma(120))[\[is\]] in His hand, and his misery #text(fill: luma(120))[\[is\]] in His hand.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وحركاته وسكناته وأقواله وأفعاله بِإِذْنِهِ ومشيئته
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))

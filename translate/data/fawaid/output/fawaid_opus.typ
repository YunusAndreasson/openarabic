  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  #text(fill: luma(120))[\[The first\]] group — they devoted what remained of their time after the obligations to bodily voluntary acts, and made them their constant practice,
]

#block(width: 100%, below: 0.2cm)[

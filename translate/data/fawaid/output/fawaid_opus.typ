  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  For His ruling — glorified #text(fill: luma(120))[\[is\]] He — covers His religious, legislative ruling and His universal, decreed ruling.
]

#block(width: 100%, below: 0.2cm)[

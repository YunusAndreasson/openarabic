  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  the second #text(fill: luma(120))[\[is\]] talking and mixing more than #text(fill: luma(120))[\[is\]] needed,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  الثَّالِثَة أَن يصير ذَلِك شَهْوَة وَعَادَة يَنْقَطِع بهَا عَن الْمَقْصُود
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  the third #text(fill: luma(120))[\[is\]] that it becomes #text(fill: luma(120))[\[a\]] desire and #text(fill: luma(120))[\[a\]] habit that cuts #text(fill: luma(120))[\[one\]] off from the goal.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

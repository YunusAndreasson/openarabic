  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  and that it #text(fill: luma(120))[\[is\]] #text(fill: luma(120))[\[a\]] summer cloud that clears away after #text(fill: luma(120))[\[a\]] short while,
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  وخيال طيف مَا استتم الزِّيَارَة حَتَّى آذن بالرحيل
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  and #text(fill: luma(120))[\[a\]] shadow of #text(fill: luma(120))[\[a\]] phantom that did not complete #text(fill: luma(120))[\[its\]] visit before announcing departure.
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)
  قَالَ النَّبِي مَالِي وللدنيا
  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  The Prophet said: "What #text(fill: luma(120))[\[have\]] I #text(fill: luma(120))[\[to do\]] with this world?
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

  #v(0.04cm)
  #set text(dir: ltr, lang: "en", font: "Noto Sans", 9pt, fill: luma(80))
  So its pleasure #text(fill: luma(120))[\[is\]] according to what it gained of that knowledge, love, and traveling #text(fill: luma(120))[\[the path\]],
]

#block(width: 100%, below: 0.2cm)[
  #set text(dir: rtl, lang: "ar", font: "Noto Naskh Arabic", 12pt)

{
  "name": "admin-dashboard",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 iOS versions"
  ],
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:public": "eslint app/page.tsx app/layout.tsx app/loading.tsx app/error.tsx app/sitemap.ts app/robots.ts app/read app/login app/account-deletion app/privacy app/terms app/contact app/download-app middleware.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm test && pnpm build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "analyze": "ANALYZE=true next build",
    "expand": "NODE_PATH=$(pwd)/node_modules/.pnpm/@supabase+supabase-js@2.98.0/node_modules:$(pwd)/node_modules/.pnpm node scripts/expand-translations.js",
    "expand:apply": "NODE_PATH=$(pwd)/node_modules/.pnpm/@supabase+supabase-js@2.98.0/node_modules:$(pwd)/node_modules/.pnpm node scripts/expand-translations.js --apply",
    "expand:llm": "NODE_PATH=$(pwd)/node_modules/.pnpm/@supabase+supabase-js@2.98.0/node_modules:$(pwd)/node_modules/.pnpm node scripts/expand-translations.js --prepare-llm"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0",
    "pnpm": ">=9.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.14",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "vitest": "^4.1.6",
    "wrangler": "^4.158.0"
  }
}

+    word && (position != null || (generation.isNotEmpty() && root != null)) -> "word"
+    !word && (position != null || (generation.isNotEmpty() && article != null)) -> "passage"
+    generation.isNotEmpty() && root != null -> "word"
+    generation.isNotEmpty() -> "practice"
+    else -> "read"
+  }

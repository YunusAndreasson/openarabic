+internal fun wordArabicBitmap(context: Context, props: TextProps, bounds: SizeParams): Bitmap {
+  val resources = context.resources
+  val metrics = resources.displayMetrics
+  val width = (bounds.width * metrics.density).roundToInt().coerceAtLeast(1)
+  val height = (bounds.height * metrics.density).roundToInt().coerceAtLeast(1)
+  val pad = ceil(metrics.density * 3).toInt()
+  val measure = (width - 2 * pad).coerceAtLeast(1)
+  val font = resources.getIdentifier("amiri", "font", context.packageName)
+  val paint = TextPaint(Paint.ANTI_ALIAS_FLAG or Paint.SUBPIXEL_TEXT_FLAG).apply {
+    typeface = if (font != 0) resources.getFont(font) else Typeface.DEFAULT
+    textLocale = Locale.forLanguageTag("ar")
+    color = colorToComposeColorOrNull(props.color)?.toArgb() ?: android.graphics.Color.BLACK
+    textSize = TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_SP, props.fontSize ?: 24f, metrics)
+  }
+
+  val text = SpannableStringBuilder()
+  fun append(span: TextSpanRecord) {
+    val start = text.length
+    span.children?.forEach(::append) ?: text.append(span.text)
+    colorToComposeColorOrNull(span.color)?.let {
+      text.setSpan(ForegroundColorSpan(it.toArgb()), start, text.length, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+    }
+  }
+  props.spans?.forEach(::append) ?: text.append(props.text)
+
+  fun line() = StaticLayout.Builder.obtain(text, 0, text.length, paint, measure)
+    .setAlignment(Layout.Alignment.ALIGN_NORMAL)
+    .setTextDirection(TextDirectionHeuristics.RTL)
+    .setIncludePad(true)
+    .setMaxLines(1)
+    .build()
+
+  val desiredWidth = Layout.getDesiredWidth(text, paint)
+  if (desiredWidth > measure) paint.textSize *= (measure - 1).coerceAtLeast(1) / desiredWidth
+  val ink = Rect()
+  val plain = text.toString()
+  paint.getTextBounds(plain, 0, plain.length, ink)
+  val availableHeight = (height - 2 * pad).coerceAtLeast(1)
+  if (ink.height() > availableHeight) {
+    paint.textSize *= availableHeight.toFloat() / ink.height()
+    paint.getTextBounds(plain, 0, plain.length, ink)
+  }
+  val layout = line()
+
+  return Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888).also {
+    val canvas = Canvas(it)
+    val baseline = (height - ink.height()) / 2f - ink.top
+    canvas.translate(pad.toFloat(), baseline - layout.getLineBaseline(0))
+    layout.draw(canvas)
+  }
+}

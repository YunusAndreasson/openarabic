@@ -0,0 +1,21 @@
+package expo.modules.widgets
+
+import java.time.Instant
+import java.time.ZoneId
+
+/** Public rotation is indexed by civil date and does not require a running app. */
+internal object WordWidgetCalendar {
+  data class Day(val face: Map<String, Any?>, val midnight: Long)
+
+  fun day(rotation: Map<*, *>?, now: Long, zone: ZoneId = ZoneId.systemDefault()): Day? {
+    val start = (rotation?.get("firstUse") as? Number)?.toLong() ?: return null
+    val faces = rotation["faces"] as? List<*> ?: return null
+    if (faces.isEmpty()) return null
+    val today = Instant.ofEpochMilli(now).atZone(zone).toLocalDate()
+    val first = Instant.ofEpochMilli(start).atZone(zone).toLocalDate()
+    val elapsed = (today.toEpochDay() - first.toEpochDay()).coerceAtLeast(0)
+    val face = faces[(elapsed % faces.size).toInt()] as? Map<*, *> ?: return null
+    val midnight = today.plusDays(1).atStartOfDay(zone).toInstant().toEpochMilli()
+    return Day(face.entries.mapNotNull { (key, value) -> (key as? String)?.let { it to value } }.toMap(), midnight)
+  }
+}

+    root?.let { uri.appendQueryParameter("r", it.toLong().toString()) }
+    article?.let { uri.appendQueryParameter("a", it.toLong().toString()) }
+    sentence?.let { uri.appendQueryParameter("s", it.toLong().toString()) }
+  }
+  return context.packageManager.getLaunchIntentForPackage(context.packageName)?.apply {
+    action = Intent.ACTION_VIEW
+    data = uri.build()

+package expo.modules.widgets
+
+import android.content.BroadcastReceiver
+import android.content.ComponentCallbacks
+import android.content.Context
+import android.content.Intent
+import android.content.res.Configuration
+
+/** Launcher RemoteViews outlive an Activity. Recompose when the system changes
+ * the appearance or text scale while the widget process is alive. */
+internal object WordWidgetConfiguration {
+  private var observed = false
+
+  @Synchronized
+  fun observe(context: Context) {
+    if (observed) return
+    observed = true
+    val application = context.applicationContext
+    var prior = Configuration(application.resources.configuration)
+    application.registerComponentCallbacks(object : ComponentCallbacks {
+      override fun onConfigurationChanged(current: Configuration) {
+        val mask = Configuration.UI_MODE_NIGHT_MASK
+        val changed = (current.uiMode and mask) != (prior.uiMode and mask) ||
+          current.fontScale != prior.fontScale || current.densityDpi != prior.densityDpi ||
+          current.locales != prior.locales
+        prior = Configuration(current)
+        if (changed) WidgetsUpdater.reload(application, WordWidgetReveal.NAME)
+      }
+
+      override fun onLowMemory() = Unit
+    })
+  }
+}
+
+class WordWidgetClockReceiver : BroadcastReceiver() {
+  override fun onReceive(context: Context, intent: Intent) {
+    WordWidgetConfiguration.observe(context)
+    val pending = goAsync()
+    WidgetsUpdater.enqueueReload(context, WordWidgetReveal.NAME).invokeOnCompletion { pending?.finish() }
+  }
+}
diff --git a/android/src/main/java/expo/modules/widgets/WordWidgetReveal.kt b/android/src/main/java/expo/modules/widgets/WordWidgetReveal.kt
new file mode 100644
--- /dev/null
+++ b/android/src/main/java/expo/modules/widgets/WordWidgetReveal.kt
@@ -0,0 +1,147 @@
+package expo.modules.widgets
+
+import android.app.AlarmManager
+import android.app.KeyguardManager
+import android.app.PendingIntent
+import android.appwidget.AppWidgetManager
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.os.Build
+import java.security.MessageDigest
+
+/** The displayed frame, its tap identity and the first instant it must be re-evaluated. */
+internal class WordRevealFrame(
+  val face: Map<String, Any?>,
+  val identity: String?,
+  val boundary: Long,
+  val evaluatedAt: Long
+) {
+  companion object {
+    @JvmOverloads
+    fun select(stored: Map<String, Any?>, seed: Map<String, Any?>, generation: String,
+               locked: Boolean, now: Long, ownerEpoch: String,
+               public: WordWidgetCalendar.Day? = null): WordRevealFrame {
+      val frames = (stored["frames"] as? List<*>)?.filterIsInstance<Map<*, *>>().orEmpty()
+      fun time(frame: Map<*, *>) = (frame["at"] as? Number)?.toLong() ?: Long.MAX_VALUE
+      val active = frames.lastOrNull { time(it) <= now }?.get("face") as? Map<*, *>
+      val current = active?.entries?.mapNotNull { (key, value) ->
+        (key as? String)?.let { it to value }
+      }?.toMap() ?: stored.minus(listOf("frames", "publicRotation"))
+      val owner = current["generation"] as? String
+      val expires = (current["expires"] as? Number)?.toLong() ?: 0L
+      val needsPublic = owner == null || owner.isEmpty() || owner != generation || locked ||
+        (expires > 0 && now >= expires)
+      val face = when {
+        needsPublic && public != null -> public.face
+        needsPublic && owner != "" -> seed
+        else -> current
+      }
+      val dueAt = (face["dueAt"] as? Number)?.toLong() ?: 0L
+      val boundary = if (needsPublic && public != null) public.midnight else listOfNotNull(
+        frames.firstOrNull { time(it) > now }?.let(::time), expires.takeIf { it > now },
+        dueAt.takeIf { it > now }).minOrNull() ?: Long.MAX_VALUE
+      val canReveal = face["due"] == false && !(face["gloss"] as? String).isNullOrBlank() &&
+        (dueAt <= 0 || now < dueAt)
+      // PendingIntents and reveal preferences contain an opaque identity, never the answer.
+      val identity = if (!canReveal) null else {
+        val fields = listOf(ownerEpoch, generation, face["generation"], face["occurrenceKey"] ?: face["key"], face["arabic"], face["gloss"], dueAt)
+        val bytes = fields.joinToString("") { "${it.toString().length}:$it" }.toByteArray()
+        MessageDigest.getInstance("SHA-256").digest(bytes).joinToString("") { "%02x".format(it) }
+      }
+      return WordRevealFrame(face, identity, boundary, now)
+    }
+  }
+}
+
+internal object WordWidgetReveal {
+  const val NAME = "WordInContext"
+  private const val DEADLINE = "word-widget.deadline"
+  private const val SHOW = "word-widget.show"
+  private const val HIDE = "word-widget.hide"
+
+  fun prefs(context: Context) = context.getSharedPreferences("word_widget", Context.MODE_PRIVATE)
+  private fun key(id: Int) = "wordReveal.$id"
+
+  fun current(context: Context): WordRevealFrame {
+    val seed = WidgetsLayoutRegistry.initialProps(context, NAME).orEmpty()
+    val stored = WidgetsLayoutRegistry.props(context, NAME) ?: seed
+    val now = System.currentTimeMillis()
+    val rotation = stored["publicRotation"] as? Map<*, *>
+    return WordRevealFrame.select(stored, seed,
+      prefs(context).getString("generation", "").orEmpty(),
+      context.getSystemService(KeyguardManager::class.java).isDeviceLocked, now,
+      prefs(context).getString("revealEpoch", "").orEmpty(), WordWidgetCalendar.day(rotation, now))
+  }
+
+  // Call with the same preferences monitor as setOwner and the final launcher write.
+  fun read(context: Context, id: Int, frame: WordRevealFrame): Boolean {
+    val prefs = prefs(context)
+    val saved = prefs.getString(key(id), null) ?: return false
+    val until = saved.substringAfter(':', "").toLongOrNull()
+    if (until != null && frame.evaluatedAt < until && saved.substringBefore(':') == frame.identity) return true
+    check(prefs.edit().remove(key(id)).commit())
+    return false
+  }
+
+  fun isStillRevealed(context: Context, id: Int, identity: String): Boolean =
+    current(context).let { it.identity == identity && read(context, id, it) }
+
+  fun interact(context: Context, id: Int, intent: Intent, frame: WordRevealFrame) {
+    if (frame.identity == null || intent.data?.lastPathSegment != frame.identity) return
+    val edit = prefs(context).edit()
+    when (intent.action) {
+      SHOW -> edit.putString(key(id), "${frame.identity}:${frame.boundary}")
+      HIDE -> edit.remove(key(id))
+      else -> return
+    }
+    check(edit.commit())
+  }
+
+  private fun intent(context: Context, id: Int, action: String, identity: String) =
+    Intent(context, WordWidgetActionReceiver::class.java).setAction(action)
+      .setData(Uri.Builder().scheme("word-widget").authority("instance")
+        .appendPath(id.toString()).appendPath(identity).build())
+      .putExtra(AppWidgetManager.EXTRA_APPWIDGET_ID, id)
+
+  fun tap(context: Context, id: Int, frame: WordRevealFrame, revealed: Boolean) =
+    frame.identity?.let { intent(context, id, if (revealed) HIDE else SHOW, it) }
+
+  private fun alarm(context: Context, id: Int, flags: Int) = PendingIntent.getBroadcast(
+    context, id, intent(context, id, DEADLINE, "refresh"), PendingIntent.FLAG_IMMUTABLE or flags)
+
+  /** A launcher retains its RemoteViews after process death. Arrange a native redraw
+   * before publishing the answer, even if the app never opens again. */
+  fun schedule(context: Context, id: Int, at: Long) {
+    val alarms = context.getSystemService(AlarmManager::class.java)
+    if (at == Long.MAX_VALUE) {
+      alarm(context, id, PendingIntent.FLAG_NO_CREATE)?.let(alarms::cancel)
+      return
+    }
+    val request = requireNotNull(alarm(context, id, PendingIntent.FLAG_UPDATE_CURRENT))
+    if (Build.VERSION.SDK_INT < 31 || alarms.canScheduleExactAlarms()) {
+      try {
+        alarms.setExactAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, at, request)
+        return
+      } catch (_: SecurityException) { /* Exact-alarm access changed during scheduling. */ }
+    }
+    alarms.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, at, request)
+  }
+
+  fun forget(context: Context, id: Int) = synchronized(prefs(context)) {
+    check(prefs(context).edit().remove(key(id)).commit())
+    schedule(context, id, Long.MAX_VALUE)
+  }
+}
+
+/** Explicit, non-exported Glance action target. No Activity or JS app session is started. */
+class WordWidgetActionReceiver : BroadcastReceiver() {
+  override fun onReceive(context: Context, intent: Intent) {
+    val id = intent.getIntExtra(AppWidgetManager.EXTRA_APPWIDGET_ID, AppWidgetManager.INVALID_APPWIDGET_ID)
+    if (id == AppWidgetManager.INVALID_APPWIDGET_ID) return
+    val pending = goAsync()
+    WidgetsUpdater.updateInstance(context.applicationContext, id, intent)
+      .invokeOnCompletion { pending.finish() }
+  }
+}

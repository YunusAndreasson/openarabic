import React, { useEffect, useMemo } from 'react';
import { View, StyleSheet, useColorScheme, AccessibilityInfo } from 'react-native';
import { LinearGradient } from 'expo-linear-gradient';
import Animated, {
  useAnimatedScrollHandler,
  useAnimatedStyle,
  useSharedValue,
  interpolate,
  Extrapolation,
} from 'react-native-reanimated';
import { useTheme } from '@react-navigation/native';
import { HEADER_HEIGHT, HEADER_IMAGE_HEIGHT } from '../constants/layout';
import { Image } from 'expo-image';

// Remove navigation prop since we're not manipulating the header anymore
type CollapsibleHeaderProps = {
  title: string;
  imageSource: any;
  children: React.ReactNode;
  accessibilityLabel?: string;
  customGradientColors?: readonly [string, string, ...string[]];
};

export const CollapsibleHeader: React.FC<CollapsibleHeaderProps> = ({
  title,
  imageSource,
  children,
  accessibilityLabel,
  customGradientColors,
}) => {
  const { colors } = useTheme();
  const isDarkMode = useColorScheme() === 'dark';
  const scrollY = useSharedValue(0);
  const SCROLL_THRESHOLD = HEADER_IMAGE_HEIGHT - HEADER_HEIGHT;

  // Memoize gradient colors to prevent unnecessary re-renders
  const gradientColors = useMemo(() => {
    // Use custom gradient colors if provided, otherwise use default
    if (customGradientColors) {
      return customGradientColors;
    }

    // Enhanced default gradient for better readability in light mode
    return isDarkMode
      ? (['transparent', colors.background] as [string, string])
      : (['transparent', 'rgba(255, 255, 255, 0.8)', colors.background] as [
          string,
          string,
          string,
        ]);
  }, [colors.background, customGradientColors, isDarkMode]);

  // Optimize scroll handler with proper throttling
  const scrollHandler = useAnimatedScrollHandler({
    onScroll: event => {
      'worklet';
      // Use withTiming for smoother scrolling experience
      scrollY.value = event.contentOffset.y;
    },
  });

  // Announce to screen readers when the component mounts
  useEffect(() => {
    if (accessibilityLabel) {
      AccessibilityInfo.announceForAccessibility(accessibilityLabel);
    }
  }, [accessibilityLabel]);

  // Memoize the image component to prevent unnecessary re-renders
  const headerImage = useMemo(
    () => (
      <Image
        source={imageSource}
        style={styles.headerImage}
        contentFit="cover"
        transition={300}
        cachePolicy="memory-disk"
        accessible={true}
        accessibilityLabel={`Header image for ${title}`}
      />
    ),
    [imageSource, title]
  );

  // Animated styles for the header image
  const headerImageAnimatedStyle = useAnimatedStyle(() => {
    return {
      height: HEADER_IMAGE_HEIGHT,
      transform: [
        {
          // Parallax effect for the header image
          translateY: interpolate(
            scrollY.value,
            [-HEADER_IMAGE_HEIGHT, 0, SCROLL_THRESHOLD],
            [HEADER_IMAGE_HEIGHT / 2, 0, -SCROLL_THRESHOLD / 3],
            Extrapolation.CLAMP
          ),
        },
        {
          // Scale effect for the header image
          scale: interpolate(
            scrollY.value,
            [-HEADER_IMAGE_HEIGHT, 0, SCROLL_THRESHOLD],
            [1.5, 1, 1],
            Extrapolation.CLAMP
          ),
        },
      ],
      opacity: interpolate(scrollY.value, [0, SCROLL_THRESHOLD], [1, 0.3], Extrapolation.CLAMP),
    };
  });

  // Animated styles for the gradient overlay
  const gradientAnimatedStyle = useAnimatedStyle(() => {
    return {
      opacity: interpolate(scrollY.value, [0, SCROLL_THRESHOLD / 2], [1, 0.9], Extrapolation.CLAMP),
    };
  });

  return (
    <View style={styles.container}>
      <Animated.View style={[styles.headerImageContainer, headerImageAnimatedStyle]}>
        {headerImage}
        <Animated.View style={[styles.gradientContainer, gradientAnimatedStyle]}>
          <LinearGradient colors={gradientColors} style={styles.gradient} pointerEvents="none" />
        </Animated.View>
      </Animated.View>

      <Animated.ScrollView
        scrollEventThrottle={16}
        onScroll={scrollHandler}
        contentContainerStyle={styles.scrollViewContent}
        showsVerticalScrollIndicator={false}
        overScrollMode="never"
        removeClippedSubviews={true}
        bounces={true}
      >
        {children}
      </Animated.ScrollView>
    </View>
  );
};

const styles = StyleSheet.create({
  container: {
    flex: 1,
  },
  scrollViewContent: {
    paddingTop: HEADER_IMAGE_HEIGHT - 100,
  },
  headerImageContainer: {
    position: 'absolute',
    top: 0,
    left: 0,
    right: 0,
    overflow: 'hidden',
    zIndex: 1,
  },
  headerImage: {
    width: '100%',
    height: '100%',
  },
  gradientContainer: {
    position: 'absolute',
    bottom: 0,
    left: 0,
    right: 0,
    height: '100%', // Make gradient cover the entire image
  },
  gradient: {
    height: '100%', // Full height gradient
    width: '100%',
  },
});

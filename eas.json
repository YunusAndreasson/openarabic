{
  "cli": {
    "version": ">= 5.9.1",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "20.19.5"
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_SENTRY_DSN": "${EXPO_PUBLIC_SENTRY_DSN}",
        "EXPO_PUBLIC_MIXPANEL_TOKEN": "${EXPO_PUBLIC_MIXPANEL_TOKEN}",
        "EXPO_PUBLIC_UPDATES_ENABLED": "true",
        "EXPO_PUBLIC_UPDATES_CHECK_AUTOMATICALLY": "ON_LOAD",
        "EXPO_PUBLIC_UPDATES_FALLBACK_TO_CACHE_TIMEOUT": "0",
        "NODE_PATH": "/Users/expo/workingdir/build",
        "SENTRY_AUTH_TOKEN": "${SENTRY_AUTH_TOKEN}",
        "SENTRY_ORG": "openarabic",
        "SENTRY_PROJECT": "react-native",
        "SENTRY_DISABLE_AUTO_UPLOAD": "false",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "resourceClass": "medium"
      },
      "env": {
        "EXPO_PUBLIC_SENTRY_DSN": "${EXPO_PUBLIC_SENTRY_DSN}",
        "EXPO_PUBLIC_MIXPANEL_TOKEN": "${EXPO_PUBLIC_MIXPANEL_TOKEN}",
        "EXPO_PUBLIC_UPDATES_ENABLED": "true",
        "EXPO_PUBLIC_UPDATES_CHECK_AUTOMATICALLY": "ON_LOAD",
        "EXPO_PUBLIC_UPDATES_FALLBACK_TO_CACHE_TIMEOUT": "0",
        "NODE_PATH": "/Users/expo/workingdir/build",
        "SENTRY_AUTH_TOKEN": "${SENTRY_AUTH_TOKEN}",
        "SENTRY_ORG": "openarabic",
        "SENTRY_PROJECT": "react-native",
        "SENTRY_DISABLE_AUTO_UPLOAD": "false",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "production": {
      "node": "20.19.5",
      "channel": "production",
      "ios": {
        "resourceClass": "medium",
        "cache": {
          "key": "yarn-deps-{{ checksum \"yarn.lock\" }}-{{ checksum \"package.json\" }}",
          "paths": [".yarn/cache", ".yarn/install-state.gz", "node_modules"]
        }
      },
      "android": {
        "resourceClass": "large",
        "buildType": "app-bundle",
        "cache": {
          "key": "yarn-deps-{{ checksum \"yarn.lock\" }}-{{ checksum \"package.json\" }}",
          "paths": [".yarn/cache", ".yarn/install-state.gz", "node_modules"]
        }
      },
      "env": {
        "EXPO_PUBLIC_SENTRY_DSN": "${EXPO_PUBLIC_SENTRY_DSN}",
        "EXPO_PUBLIC_MIXPANEL_TOKEN": "${EXPO_PUBLIC_MIXPANEL_TOKEN}",
        "EXPO_PUBLIC_UPDATES_ENABLED": "true",
        "EXPO_PUBLIC_UPDATES_CHECK_AUTOMATICALLY": "ON_LOAD",
        "EXPO_PUBLIC_UPDATES_FALLBACK_TO_CACHE_TIMEOUT": "0",
        "NODE_PATH": "/Users/expo/workingdir/build",
        "SENTRY_AUTH_TOKEN": "${SENTRY_AUTH_TOKEN}",
        "SENTRY_ORG": "openarabic",
        "SENTRY_PROJECT": "react-native",
        "SENTRY_DISABLE_AUTO_UPLOAD": "false",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "",
        "ascAppId": "1594031029",
        "appleTeamId": "G9UUQ9MDS4"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}

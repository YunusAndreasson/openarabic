{
  "cli": {
    "version": ">= 5.9.1",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "22.23.1",
      "corepack": true
    },
    "development": {
      "developmentClient": true,
      "corepack": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "NODE_PATH": "/Users/expo/workingdir/build",
        "SENTRY_ORG": "openarabic",
        "SENTRY_PROJECT": "react-native",
        "SENTRY_DISABLE_AUTO_UPLOAD": "false",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "preview": {
      "corepack": true,
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "ios": {
        "resourceClass": "medium"
      },
      "env": {
        "NODE_PATH": "/Users/expo/workingdir/build",
        "SENTRY_ORG": "openarabic",
        "SENTRY_PROJECT": "react-native",
        "SENTRY_DISABLE_AUTO_UPLOAD": "false",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "production": {
      "node": "22.23.1",
      "corepack": true,
      "channel": "production",
      "environment": "production",
      "ios": {
        "resourceClass": "medium"
      },
      "android": {
        "resourceClass": "medium",
        "buildType": "app-bundle"
      },
      "env": {
        "NODE_PATH": "/Users/expo/workingdir/build",
        "SENTRY_ORG": "openarabic",
        "SENTRY_PROJECT": "react-native",
        "SENTRY_DISABLE_AUTO_UPLOAD": "false",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "",
        "ascAppId": "1594031029",
        "appleTeamId": "G9UUQ9MDS4"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}

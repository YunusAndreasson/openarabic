## Types

### Core Types (`types/`)
```typescript
// Article types
interface Article {
  id: number;
  title: string;
  author_name: string;
  summary: string;
  audio_url: string | null;
  image_url: string | null;
  difficulty_level: number;
  category_name: string;
}

// Vocabulary types
interface StudyWord {
  root_id: number;
  user_id: string;
  fsrs_due: string;
  fsrs_state: number;
  fsrs_difficulty: number;
  fsrs_stability: number;
  root?: Root;
}

interface Root {
  id: number;
  letters: string;
  meaning: string;
  audio_url: string | null;
  audio_url_en: string | null;
}

// Audio types
interface EnhancedAudioTrack {
  id: string;
  articleId: number;
  audioUrl: string | null;
  title: string;
}

// Navigation types
interface TabParamList {
  read: undefined;
  practice: undefined;
  listen: undefined;
}
```

## Query Keys Reference

### Standard Query Key Patterns
```typescript
// Articles
['articles', userId, filters]
['article', articleId]
['articles-by-due-words', userId, limit]

// FSRS/Vocabulary
['fsrs-words', userId]
['fsrs-due-words', userId, limit]
['fsrs-stats', userId]

// Reading List
['readingList', userId]
['readingListStatus', userId, articleId]

// Audio
['enhancedAudioTracks', userId]

// Categories
['categories']
['bookmarkCategories', userId]
```

## Redux Store Structure

### State Shape
```typescript
interface RootState {
  theme: {
    theme: 'light' | 'dark';
  };
  settings: {
    fontScale: number;
    reminderTime: ReminderTime;
  };
  readingList: {
    cachedData: ReadingListItem[];
    lastFetch: number | null;
  };
  filters: {
    selectedCategories: number[];
    selectedAuthors: number[];
    difficultyRange: [number, number];
    sortBy: SortOption;
  };
  listen: {
    currentTrackId: string | null;
    isPlaying: boolean;
  };
}
```

### Actions
```typescript
// Theme actions
setTheme(theme: 'light' | 'dark')

// Settings actions
setFontScale(scale: number)
setReminderTime(time: ReminderTime)

// Filter actions
setSelectedCategories(categories: number[])
setSelectedAuthors(authors: number[])
setDifficultyRange(range: [number, number])
setSortBy(sortBy: SortOption)
```

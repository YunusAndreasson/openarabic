# API Reference Guide

## Services

### Articles Service (`services/articles.ts`)
```typescript
articlesService.getArticles(userId: string, filters?: ArticleFilters): Promise<Article[]>
articlesService.getArticleById(id: number): Promise<Article>
articlesService.getArticlesByDueWords(userId: string, limit: number): Promise<ArticleWithWordStats[]>
```

### Reading List Service (`services/readingList.ts`)
```typescript
readingListService.getReadingList(userId: string): Promise<ReadingListItem[]>
readingListService.addToReadingList(userId: string, articleId: number): Promise<void>
readingListService.removeFromReadingList(userId: string, articleId: number): Promise<void>
readingListService.isInReadingList(userId: string, articleId: number): Promise<boolean>
```

### FSRS Service (`services/studyWordsFSRS.ts`)
```typescript
studyWordsFSRSService.getStudyWords(userId: string): Promise<StudyWord[]>
studyWordsFSRSService.getDueWords(userId: string, limit?: number): Promise<StudyWord[]>
studyWordsFSRSService.addStudyWord(userId: string, rootId: number): Promise<void>
studyWordsFSRSService.removeStudyWord(userId: string, rootId: number): Promise<void>
studyWordsFSRSService.reviewWord(userId: string, rootId: number, grade: Grade): Promise<void>
studyWordsFSRSService.getStudyStats(userId: string): Promise<StudyStats>
```

### Enhanced Audio Service (`services/enhancedAudioService.ts`)
```typescript
enhancedAudioService.generateEnhancedAudioTrack(articleId: number): Promise<EnhancedAudioTrack | null>
enhancedAudioService.getReadingListEnhancedTracks(userId: string): Promise<EnhancedAudioTrack[]>
```

## Hooks

### Authentication Hooks

#### `useAuth()` - Authentication state management
```typescript
const { user, session, isLoading, signIn, signOut, signUp } = useAuth();
```

#### `useAuthForm()` - Form handling for auth screens
```typescript
const {
  email, setEmail,
  password, setPassword,
  isLoading,
  handleSignIn,
  handleSignUp,
  validateForm
} = useAuthForm();
```

### Article Hooks

#### `useArticleData()` - Fetch article and related data
```typescript
const {
  article,
  isLoadingArticle,
  selectedWordIds,
  sortedSentences,
  sentenceWordsMap,
  isInReadingList,
  refetchStudyWords,
  refetchReadingListStatus
} = useArticleData(articleId, userId);
```

#### `useArticleMutations()` - Article-related mutations
```typescript
const {
  handleToggleReadingList,
  isLoading
} = useArticleMutations(userId, onSuccess);
```

#### `useArticlesByDueWords()` - Articles with vocabulary data
```typescript
const {
  articles,
  isLoading,
  dueWordRootIds,
  refetch
} = useArticlesByDueWords(userId, limit);
```

### Vocabulary/FSRS Hooks

#### `useFSRSWords()` - FSRS vocabulary management
```typescript
const {
  studyWords,
  dueWords,
  isLoading,
  addWord,
  removeWord,
  reviewWord,
  refetch
} = useFSRSWords(userId);
```

#### `useArabicWord()` - Individual word interaction
```typescript
const {
  isAudioHighlighted,
  isSelected,
  setForceSelected,
  handleSelectionChange
} = useArabicWord({ word, position, onPress });
```

### Audio Hooks

#### `useAudioPlayer()` - Enhanced audio playback
```typescript
const {
  progress,
  metadata,
  audioState,
  currentTrackIndex,
  isLoading,
  position,
  duration,
  actions: { stopPlayback, startEnhancedPlayback, prefetchTracks }
} = useAudioPlayer();
```

#### `useListenScreen()` - Listen tab functionality
```typescript
const {
  sortedReadingList,
  sortedEnhancedTracks,
  isReadingListLoading,
  enhancedTracksError,
  shouldShowInitialLoading,
  isCurrentlyPlaying,
  listenMetadata
} = useListenScreen();
```

### UI Hooks

#### `useColors()` - Theme-aware colors
```typescript
const colors = useColors(); // Returns current theme colors
```

#### `useIsDarkMode()` - Dark mode detection
```typescript
const isDarkMode = useIsDarkMode();
```

#### `useHeaderVisibility()` - Header scroll behavior
```typescript
const { handleScroll } = useHeaderVisibility();
```

#### `useOpacityAnimation()` - Fade animations
```typescript
const { fadeIn, animatedStyle } = useOpacityAnimation({
  initialOpacity: 0,
  duration: 300,
  autoStart: false
});
```

#### `useScaleAnimation()` - Press animations
```typescript
const { handlePressIn, handlePressOut, animatedStyle } = useScaleAnimation();
```

### Navigation Hooks

#### `useScreenFocusRefresh()` - Auto-refresh on screen focus
```typescript
useScreenFocusRefresh(
  queryClient,
  'readingList',
  userId,
  1000 * 60 * 5, // 5 minutes
  true, // enabled
  true  // refetchOnMount
);
```

## Utilities

### Error Handling (`utils/errorHandling.ts`)
```typescript
handleError(error: Error | string, options?: ErrorOptions): Promise<void>

interface ErrorOptions {
  showToast?: boolean;
  toastMessage?: string;
  toastDuration?: number;
  toastType?: 'error' | 'important' | 'info' | 'success';
  trackAnalytics?: boolean;
  analyticsEventName?: string;
  analyticsProperties?: Record<string, boolean | number | string>;
  captureSentry?: boolean;
  sentrySeverity?: 'debug' | 'error' | 'fatal' | 'info' | 'warning';
}
```

### Haptic Feedback (`utils/haptics.ts`)
```typescript
lightFeedback(): void        // Light tap feedback

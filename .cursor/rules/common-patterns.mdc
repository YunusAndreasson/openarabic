# Common Development Patterns

## Hook Patterns

### 1. Data Fetching Hook Pattern
```typescript
export function useArticleData(articleId?: number, userId?: string) {
  const { data: article, isLoading: isLoadingArticle } = useQuery({
    queryKey: ['article', articleId],
    queryFn: () => articlesService.getArticleById(articleId!),
    enabled: !!articleId,
    staleTime: 1000 * 60 * 5, // 5 minutes
  });

  const { data: studyWords, refetch: refetchStudyWords } = useQuery({
    queryKey: ['fsrs-words', userId],
    queryFn: () => studyWordsFSRSService.getStudyWords(userId!),
    enabled: !!userId,
  });

  return {
    article,
    isLoadingArticle,
    studyWords,
    refetchStudyWords,
  };
}
```

### 2. Mutation Hook Pattern
```typescript
export function useArticleMutations(userId?: string, onSuccess?: () => void) {
  const queryClient = useQueryClient();

  const addToReadingListMutation = useMutation({
    mutationFn: (articleId: number) => 
      readingListService.addToReadingList(userId!, articleId),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ['readingList', userId] });
      onSuccess?.();
    },
    onError: (error) => {
      handleError(error, { toastMessage: 'Failed to add to reading list' });
    },
  });

  return {
    handleToggleReadingList: addToReadingListMutation.mutate,
    isLoading: addToReadingListMutation.isPending,
  };
}
```

### 3. UI State Hook Pattern
```typescript
export function useListenUI({ sortedReadingList, metadata, audioState }) {
  const [canShowEmpty, setCanShowEmpty] = useState(false);

  // Prevent empty state flash
  useEffect(() => {
    const timer = setTimeout(() => setCanShowEmpty(true), 1000);
    return () => clearTimeout(timer);
  }, []);

  const flashListExtraData = useMemo(() => ({
    audioState,
    currentArticleId: metadata?.articleId,
  }), [audioState, metadata?.articleId]);

  return {
    canShowEmpty,
    flashListExtraData,
  };
}
```

## Component Patterns

### 1. Screen Component Pattern
```typescript
export default function ArticleScreen(): JSX.Element {
  const { id } = useLocalSearchParams<{ id: string }>();
  const colors = useColors();
  const { user } = useAuth();

  const articleId = useMemo(() => {
    const parsed = parseInt(id ?? '', 10);
    return isNaN(parsed) ? undefined : parsed;
  }, [id]);

  const { article, isLoadingArticle } = useArticleData(articleId, user?.id);

  if (isLoadingArticle) {
    return <LoadingState />;
  }

  return (
    <View style={[styles.container, { backgroundColor: colors.background }]}>
      {/* Content */}
    </View>
  );
}
```

### 2. List Item Component Pattern
```typescript
const ListItem = memo(({ item, onPress, isActive }: ListItemProps) => {
  const colors = useColors();
  
  const handlePress = useCallback(() => {
    lightFeedback();
    onPress(item);
  }, [item, onPress]);

  return (
    <TouchableOpacity
      style={[styles.container, { backgroundColor: colors.card }]}
      onPress={handlePress}
      activeOpacity={0.7}
    >
      {/* Content */}
    </TouchableOpacity>
  );
});
```

### 3. Modal Component Pattern
```typescript
export function CustomModal({ visible, onClose, children }: ModalProps) {
  const colors = useColors();
  const insets = useSafeAreaInsets();

  return (
    <Modal
      visible={visible}
      animationType="slide"
      presentationStyle="pageSheet"
      onRequestClose={onClose}
    >
      <View style={[styles.container, { 
        backgroundColor: colors.background,
        paddingTop: insets.top 
      }]}>
        <View style={styles.header}>
          <TouchableOpacity onPress={onClose}>
            <Ionicons name="close" size={24} color={colors.text} />
          </TouchableOpacity>
        </View>
        {children}
      </View>
    </Modal>
  );
}
```

## Service Patterns

### 1. Supabase Service Pattern
```typescript
export const articlesService = {
  async getArticleById(id: number): Promise<Article> {
    const { data, error } = await supabase
      .from('articles_list_view')
      .select('*')
      .eq('id', id)
      .single();

    if (error) {
      await handleError(error, {
        toastMessage: 'Failed to load article',
        analyticsEventName: 'Article_Load_Error',
        analyticsProperties: { articleId: id },
      });
      throw error;
    }

    return data;
  },
};
```

### 2. Error Handling Pattern
```typescript
try {
  const result = await someAsyncOperation();
  return result;
} catch (error) {
  await handleError(error instanceof Error ? error : new Error(String(error)), {
    toastMessage: 'Operation failed',
    analyticsEventName: 'Operation_Error',
    analyticsProperties: { context: 'specific_operation' },
    sentrySeverity: 'error',
  });
  throw error;
}
```


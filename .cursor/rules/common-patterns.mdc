## Query Key Patterns

### 1. Consistent Query Keys
```typescript
// Articles
const articleKeys = {
  all: ['articles'] as const,
  lists: () => [...articleKeys.all, 'list'] as const,
  list: (userId: string, filters: ArticleFilters) => 
    [...articleKeys.lists(), userId, filters] as const,
  details: () => [...articleKeys.all, 'detail'] as const,
  detail: (id: number) => [...articleKeys.details(), id] as const,
};

// FSRS/Vocabulary
const fsrsKeys = {
  all: ['fsrs-words'] as const,
  user: (userId: string) => [...fsrsKeys.all, userId] as const,
  due: (userId: string, limit: number) => 
    ['fsrs-due-words', userId, limit] as const,
  stats: (userId: string) => ['fsrs-stats', userId] as const,
};
```

### 2. Query Invalidation Pattern
```typescript
// Invalidate specific queries
queryClient.invalidateQueries({ queryKey: ['readingList', userId] });

// Invalidate query families
queryClient.invalidateQueries({ queryKey: fsrsKeys.user(userId) });

// Remove specific queries
queryClient.removeQueries({ queryKey: ['article', articleId] });
```

## Testing Patterns

### 1. Hook Testing Pattern
```typescript
describe('useArticleData', () => {
  it('should fetch article data when articleId is provided', async () => {
    const { result } = renderHook(() => useArticleData(123, 'user-id'));
    
    await waitFor(() => {
      expect(result.current.isLoadingArticle).toBe(false);
    });
    
    expect(result.current.article).toBeDefined();
  });
});
```

### 2. Component Testing Pattern
```typescript
describe('ArticleCard', () => {
  it('should render article information correctly', () => {
    const mockArticle = { id: 1, title: 'Test Article', author: 'Test Author' };
    
    render(<ArticleCard article={mockArticle} onPress={jest.fn()} />);
    
    expect(screen.getByText('Test Article')).toBeOnTheScreen();
    expect(screen.getByText('Test Author')).toBeOnTheScreen();
  });
});
```


### Translation-Specific Error Handling

```python
class TranslationError(Exception):
    """Custom exception for translation-related errors."""
    pass

def translate_with_fallback(text: str) -> TranslationResult:
    try:
        return primary_translation_method(text)
    except OpenAIError:
        logger.warning("Primary translation failed, using fallback")
        return google_cloud_fallback(text)
    except Exception as e:
        logger.error(f"All translation methods failed: {e}")
        return create_error_result(text, str(e))
```


### Resource Management

```python
# ✅ Proper cleanup with context managers
from contextlib import contextmanager
import tempfile
import shutil

@contextmanager
def temporary_directory():
    temp_dir = tempfile.mkdtemp()
    try:
        yield temp_dir
    finally:
        shutil.rmtree(temp_dir, ignore_errors=True)

def process_audio_file(filepath: str) -> str | None:
    with temporary_directory() as temp_dir:
        result = process_in_temp_dir(temp_dir, filepath)
        return result
```

### State Management

```python
# ✅ Avoid global mutable state
class SupabaseClient:
    _instance = None

    def __new__(cls):
        if cls._instance is None:
            cls._instance = super().__new__(cls)
            cls._instance._client = None
        return cls._instance

    def get_client(self):
        if self._client is None:
            # Initialize client
            pass
        return self._client

# ❌ Global mutable state
_supabase_client = None

def get_supabase_client():
    global _supabase_client  # Avoid global variables
    if _supabase_client is None:
        # ... initialization
    return _supabase_client
```

## Performance Considerations

### Caching Strategy

```python
# ✅ Efficient caching with validation
def get_cached_audio(cache_key: str) -> str | None:
    cache_path = os.path.join(AUDIO_CACHE_DIR, cache_key)

    if os.path.exists(cache_path) and validate_mp3_file(cache_path):
        return f"{SUPABASE_URL}/storage/v1/object/public/audio/{cache_key}"

    return None
```

### Batch Processing

```python
# ✅ Efficient batch operations
def process_translations(translations: list[dict]) -> list[dict]:
    results = []
    for batch in chunk_list(translations, BATCH_SIZE):
        batch_results = process_batch(batch)
        results.extend(batch_results)
    return results
```


```python
# Batch processing with proper error handling
def batch_translate_sentences(sentences: list[str]) -> TranslationResults:
    results: TranslationResults = []
    for sentence in sentences:
        try:
            result = translate_single_sentence(sentence)
            results.append(result)
        except TranslationError as e:
            logger.error(f"Translation failed for sentence: {e}")
            results.append(create_fallback_result(sentence))
    return results

# Proper Arabic text handling
def process_arabic_text(text: str) -> str:
    # Ensure proper encoding
    if not text or not text.strip():
        return ""
    # Preserve original formatting
    return text.strip()
```

